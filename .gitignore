memlog/pull.log
memlog/mem.csv
tvagent/agent.log
tvgate/*.log
.DS_Store
*.idsig
tvgate/sleephook
cfquota/.wrangler/

# 本機憑證與建置輸出
.env
.env.*
!.env.example
.dev.vars
*.properties
!*.example.properties
*.links.txt
tvgate.tokens.json
tvgate.token
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
