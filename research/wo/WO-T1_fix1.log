#!/usr/bin/env python3
import datetime
import hmac
import json
import os
import signal
import subprocess
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

HOME = Path(os.environ.get('TVGATE_HOME', Path.home() / 'Library/Application Support/tvgate'))
TOKEN = Path(os.environ.get('TVGATE_TOKEN', Path.home() / '.secrets/tvgate.token'))
ADB = os.environ.get('ADB', 'adb')
HOOK = os.environ.get('TVGATE_HOOK', str(Path(__file__).with_name('sleephook')))
NOTIFY = os.environ.get('TVGATE_NOTIFY', 'osascript')
INTERVAL = float(os.environ.get('TVGATE_INTERVAL', '30'))
DEVICE = '192.0.2.69:5555'
PACKAGE = 'com.google.android.youtube.tv'
STATE = HOME / 'state.json'
LOG = Path.home() / 'Library/Logs/tvgate.log'
state_lock = threading.RLock()
adb_lock = threading.Lock()
children_lock = threading.Lock()
children = set()
stop = threading.Event()
until = None
tv = 'unknown'
checked_at = None
grace = False
failed_since = None
last_apply = 0
hook = None
revision = 0


def log(action, result):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open('a') as f:
            f.write(f'{datetime.datetime.now().isoformat(timespec="seconds")} {action} {result}\n')
    except OSError:
        pass


def authorized():
    return until is not None and until > time.time()


def display(timestamp, fmt='%H:%M'):
    return datetime.datetime.fromtimestamp(timestamp).strftime(fmt) if timestamp is not None else None


def load():
    global until
    try:
        value = json.loads(STATE.read_text())['until']
        if value is not None and (not isinstance(value, (int, float)) or isinstance(value, bool)):
            raise ValueError('invalid until')
        until = value
    except FileNotFoundError:
        pass
    except (OSError, ValueError, KeyError, TypeError):
        log('state', 'invalid')
        until = None


def save(value):
    HOME.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=HOME, delete=False) as f:
            name = f.name
            json.dump({'until': value}, f)
        os.replace(name, STATE)
    finally:
        if name and os.path.exists(name):
            os.unlink(name)


def command(args, deadline=None, retry=True):
    def run(cmd):
        timeout = min(8, max(0.01, deadline - time.monotonic())) if deadline else 8
        try:
            with children_lock:
                if stop.is_set() and deadline is None:
                    return None
                process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                children.add(process)
            try:
                stdout, stderr = process.communicate(timeout=timeout)
                return subprocess.CompletedProcess(cmd, process.returncode, stdout, stderr)
            except subprocess.TimeoutExpired:
                process.kill()
                process.communicate()
                return None
            finally:
                with children_lock:
                    children.discard(process)
        except OSError:
            return None
    result = run([ADB, '-s', DEVICE] + args)
    if retry and (result is None or result.returncode != 0) and (deadline is None or time.monotonic() < deadline):
        run([ADB, '-s', DEVICE, 'connect', DEVICE])
        if deadline is None or time.monotonic() < deadline:
            result = run([ADB, '-s', DEVICE] + args)
    return result


def read_tv(deadline=None):
    global tv, checked_at, failed_since
    args = ['shell', 'pm', 'list', 'packages', '-d', '--user', '0']
    result = command(args, deadline)
    if result is not None and result.returncode == 0 and not result.stdout.strip() and (deadline is None or time.monotonic() < deadline):
        command(['connect', DEVICE], deadline, retry=False)
        result = command(args, deadline)
    with state_lock:
        if result is None or result.returncode or not result.stdout.strip():
            tv = 'unknown'
            if failed_since is None:
                failed_since = time.monotonic()
            return False
        tv = 'locked' if 'package:' + PACKAGE in result.stdout.splitlines() else 'open'
        checked_at = display(time.time(), '%H:%M:%S')
        return True


def foreground(deadline=None):
    result = command(['shell', 'dumpsys', 'activity', 'activities'], deadline)
    return bool(result and result.returncode == 0 and any('mResumedActivity' in line and PACKAGE in line for line in result.stdout.splitlines()))


def apply(forced_open=False, deadline=None):
    global last_apply, grace
    timeout = max(0, deadline - time.monotonic()) if deadline else -1
    if not adb_lock.acquire(timeout=timeout):
        return False
    try:
        if not read_tv(deadline):
            return False
        with state_lock:
            desired = 'open' if forced_open or authorized() else 'locked'
            in_grace = grace and not forced_open and desired == 'locked'
        if in_grace:
            if foreground(deadline):
                return True
            with state_lock:
                grace = False
        with state_lock:
            desired = 'open' if forced_open or authorized() else 'locked'
            current = tv
        if current != desired:
            log('apply', desired)
            if desired == 'locked':
                command(['shell', 'am', 'force-stop', PACKAGE], deadline)
                command(['shell', 'pm', 'disable-user', '--user', '0', PACKAGE], deadline)
            else:
                command(['shell', 'pm', 'enable', '--user', '0', PACKAGE], deadline)
            if not read_tv(deadline):
                return False
        with state_lock:
            last_apply = time.monotonic()
            return tv == desired
    finally:
        adb_lock.release()


def arrival():
    global grace
    with adb_lock:
        with state_lock:
            allowed = authorized()
            arrival_revision = revision
        watching = not allowed and foreground()
        with state_lock:
            # A request may have changed authorization while the foreground was read.
            watching = watching and not authorized() and revision == arrival_revision
            if watching:
                grace = True
        if watching:
            log('arrival', 'YouTube playing; grace')
            try:
                subprocess.run([NOTIFY, '-e', 'display notification "有人正在看 YouTube，要停請按立即鎖" with title "tvgate"'], timeout=8, capture_output=True)
            except (OSError, subprocess.TimeoutExpired):
                log('notification', 'failed')
    apply()


def monitor():
    global failed_since
    previous_authorized = authorized()
    while not stop.wait(min(5, INTERVAL)):
        with state_lock:
            now_authorized = authorized()
            expired = previous_authorized and not now_authorized
            previous_authorized = now_authorized
            due = time.monotonic() - last_apply >= INTERVAL
            had_failure = failed_since
        if expired or due or had_failure is not None:
            with adb_lock:
                success = read_tv()
            if success:
                with state_lock:
                    recovery = failed_since is not None and time.monotonic() - failed_since >= 120
                    failed_since = None
                if recovery:
                    arrival()
                else:
                    apply()



