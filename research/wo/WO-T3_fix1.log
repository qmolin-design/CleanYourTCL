        self.assertTrue(self.request('/lock')[1]['ok'])
        self.assertLess(time.monotonic() - start, 1)
        self.assertEqual((self.state()['tv'], self.state()['authorized']), ('locked', False))
        self.assert_lock_sequence(before)

