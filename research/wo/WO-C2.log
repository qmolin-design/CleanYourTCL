package com.example.tvagent;

import java.io.ByteArrayOutputStream;
import java.io.DataInputStream;
import java.io.EOFException;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.math.BigInteger;
import java.net.InetSocketAddress;
import java.net.Socket;
import java.net.SocketException;
import java.net.SocketTimeoutException;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.interfaces.RSAPublicKey;
import java.security.spec.RSAPublicKeySpec;
import java.security.spec.PKCS8EncodedKeySpec;
import java.security.spec.RSAPrivateCrtKeySpec;
import java.util.Base64;

import javax.crypto.Cipher;

/**
 * adb 傳輸協定連線端（純 Java，不依賴任何 android.* API）。
 *
 * 流程：TCP 連線 → 送 CNXN → 回 AUTH TOKEN 就送 SIGNATURE，被拒再送
 * RSAPUBLICKEY → 對方回 CNXN 即認證完成 → OPEN "shell:&lt;cmd&gt;" 收 WRTE 回 CLSE。
 *
 * 錯誤分類（AdbException.kind）：connect / auth_timeout / auth_rejected /
 * tls_required / protocol / io。
 */
public class AdbClient {

    public static final String CONNECT = "connect";
    public static final String AUTH_TIMEOUT = "auth_timeout";
    public static final String AUTH_REJECTED = "auth_rejected";
    public static final String TLS_REQUIRED = "tls_required";
    public static final String PROTOCOL = "protocol";
    public static final String IO = "io";

    public static class AdbException extends Exception {
        public final String kind;

        public AdbException(String kind, String message) {
            super(message);
            this.kind = kind;
        }

        public AdbException(String kind, String message, Throwable cause) {
            super(message, cause);
            this.kind = kind;
        }
    }

    // adb protocol message commands（小端組出 ASCII）。
    static final int CMD_CNXN = 0x4e584e43; // "CNXN"
    static final int CMD_AUTH = 0x48545541; // "AUTH"
    static final int CMD_OPEN = 0x4e45504f; // "OPEN"
    static final int CMD_OKAY = 0x59414b4f; // "OKAY"
    static final int CMD_WRTE = 0x45545257; // "WRTE"
    static final int CMD_CLSE = 0x45534c43; // "CLSE"
    static final int CMD_STLS = 0x534c5453; // "STLS"

    static final int AUTH_TOKEN = 1;
    static final int AUTH_SIGNATURE = 2;
    static final int AUTH_RSAPUBLICKEY = 3;

    static final int VERSION = 0x01000000;
    static final int MAXDATA = 4096;
    static final int MAX_PAYLOAD = 4 * 1024 * 1024;
    static final byte[] EMPTY = new byte[0];

    static final String PUBKEY_COMMENT = "tvagent@tv";

    // SHA-1 DigestInfo 前綴（不含 digest 本體）：adbd 把 20 bytes token
    // 當成現成 digest 直接包進去，不再雜湊（等同 RSA_sign(NID_sha1)）。
    static final byte[] DIGEST_INFO_PREFIX = {
        (byte) 0x30, (byte) 0x21, (byte) 0x30, (byte) 0x09,
        (byte) 0x06, (byte) 0x05, (byte) 0x2b, (byte) 0x0e,
        (byte) 0x03, (byte) 0x02, (byte) 0x1a, (byte) 0x05,
        (byte) 0x00, (byte) 0x04, (byte) 0x14,
    };

    static final class Msg {
        int cmd;
        int arg0;
        int arg1;
        byte[] payload;
    }

    // ---- 封包序列化（測試的假 adbd 也共用；純靜態，不碰 socket 狀態） ----

    static int checksum(byte[] b, int len) {
        long sum = 0;
        for (int i = 0; i < len; i++) {
            sum += b[i] & 0xff;
        }
        return (int) (sum & 0xffffffffL);
    }

    static void writeMessage(OutputStream out, int cmd, int arg0, int arg1, byte[] payload)
            throws IOException {
        ByteBuffer h = ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
        h.putInt(cmd);
        h.putInt(arg0);
        h.putInt(arg1);
        h.putInt(payload.length);
        h.putInt(checksum(payload, payload.length));
        h.putInt(cmd ^ 0xffffffff);
        out.write(h.array());
        out.write(payload);
        out.flush();
    }

    /** peerVersion &lt; 0 表尚未收到對方 CNXN（此時 checksum 0 不算合法）。 */
    static Msg readMessage(DataInputStream in, long peerVersion) throws IOException, AdbException {
        byte[] h = new byte[24];
        in.readFully(h); // 不足即丟 EOFException，由呼叫端依階段分類
        ByteBuffer b = ByteBuffer.wrap(h).order(ByteOrder.LITTLE_ENDIAN);
        Msg m = new Msg();
        m.cmd = b.getInt();
        m.arg0 = b.getInt();
        m.arg1 = b.getInt();
        int len = b.getInt();
        int cksum = b.getInt();
        int magic = b.getInt();
        if (magic != (m.cmd ^ 0xffffffff)) {
            throw new AdbException(PROTOCOL, "bad magic for " + cmdName(m.cmd));
        }
        if (len < 0 || len > MAX_PAYLOAD) {
            throw new AdbException(PROTOCOL, "bad length " + len);
        }
        byte[] p = new byte[len];
        in.readFully(p);
        if (cksum != 0 || peerVersion < 0 || peerVersion < 0x01000001L) {
            // 對方 version>=0x01000001 時可能送 checksum 0，視為合法。
            if (checksum(p, len) != cksum) {
                throw new AdbException(PROTOCOL, "bad checksum for " + cmdName(m.cmd));
            }
        }
        m.payload = p;
        return m;
    }

    static String cmdName(int cmd) {
        byte[] b = new byte[4];
        b[0] = (byte) (cmd & 0xff);
        b[1] = (byte) ((cmd >> 8) & 0xff);
        b[2] = (byte) ((cmd >> 16) & 0xff);
        b[3] = (byte) ((cmd >> 24) & 0xff);
        return new String(b, StandardCharsets.US_ASCII).replaceAll("[^A-Z]", "?");
    }

    // ---- 金鑰 ----

    /** PEM 解析結果：DER 位元組＋是否為 PKCS#1。 */
    static final class PemDer {
        byte[] der;
        boolean pkcs1;
    }

    /** PEM 文字 → DER 位元組，接受 PKCS#8（BEGIN PRIVATE KEY）或 PKCS#1（BEGIN RSA PRIVATE KEY）。
     * 失敗一律丟帶步驟的 IOException（哪一步、什麼內容），並鏈住原始例外。 */
    static PemDer pemToDer(String pem) throws IOException {
        String body;
        boolean pkcs1;
        if (pem.contains("BEGIN RSA PRIVATE KEY")) {
            pkcs1 = true;
            body = pem.replace("-----BEGIN RSA PRIVATE KEY-----", "")
                    .replace("-----END RSA PRIVATE KEY-----", "");
        } else if (pem.contains("BEGIN PRIVATE KEY")) {
            pkcs1 = false;
            body = pem.replace("-----BEGIN PRIVATE KEY-----", "")
                    .replace("-----END PRIVATE KEY-----", "");
        } else {
            throw new IOException(
                    "key PEM: unknown type (want 'BEGIN PRIVATE KEY' or 'BEGIN RSA PRIVATE KEY')");
        }
        body = body.replaceAll("\\s", "");
        try {
            PemDer r = new PemDer();
            r.der = Base64.getDecoder().decode(body);
            r.pkcs1 = pkcs1;
            return r;
        } catch (IllegalArgumentException e) {
            throw new IOException("key PEM: base64 decode failed: " + e.getMessage(), e);
        }
    }

    /** 從 PEM 文字載入私鑰，接受 PKCS#8（BEGIN PRIVATE KEY）或 PKCS#1（BEGIN RSA PRIVATE KEY）。 */
    public static PrivateKey loadPrivateKey(String pem) throws Exception {
        PemDer pd = pemToDer(pem);
        KeyFactory kf = KeyFactory.getInstance("RSA");
        try {
            if (!pd.pkcs1) {
                return kf.generatePrivate(new PKCS8EncodedKeySpec(pd.der));
            }
            return kf.generatePrivate(parsePkcs1(pd.der));
        } catch (Exception e) {
            throw new IOException("load private key: KeyFactory generatePrivate failed ("
                    + (pd.pkcs1 ? "PKCS#1" : "PKCS#8") + ", der " + pd.der.length + " bytes): "
                    + e.getMessage(), e);
        }
    }

    public static PrivateKey loadPrivateKey(File f) throws Exception {
        return loadPrivateKey(readAll(f));
    }

    /** 從 DER 位元組直接解析 modulus／publicExponent 產生公鑰：不碰任何金鑰物件，
     * 不呼叫 getKeySpec、不讀金鑰物件的 getEncoded、不做任何轉型。
     * Conscrypt（電視）與桌面 JVM 走同一條路，行為一致。 */
    static PublicKey publicKeyFromDer(byte[] der, boolean pkcs1) throws Exception {
        RSAPrivateCrtKeySpec crt;
        try {
            crt = pkcs1 ? parsePkcs1(der) : parsePkcs8(der);
        } catch (IOException e) {
            throw new IOException("derive public key: DER parse failed ("
                    + (pkcs1 ? "PKCS#1" : "PKCS#8") + ", " + der.length + " bytes): "
                    + e.getMessage(), e);
        }
        return publicKeyFromCrt(crt, "derive public key");
    }

    /** 用已解析出的 CRT 參數產生公鑰；modulus／publicExponent 缺失時丟具體錯誤。 */
    static PublicKey publicKeyFromCrt(RSAPrivateCrtKeySpec crt, String step) throws Exception {
        BigInteger n = crt.getModulus();
        BigInteger e = crt.getPublicExponent();
        if (n == null || n.signum() <= 0) {
            throw new IOException(step + ": modulus missing or not positive");
        }
        if (e == null || e.signum() <= 0) {
            throw new IOException(step + ": publicExponent missing or not positive"
                    + " (modulus " + n.bitLength() + " bits)"
                    + " — key material does not carry a usable public exponent");
        }
        try {
            return KeyFactory.getInstance("RSA").generatePublic(new RSAPublicKeySpec(n, e));
        } catch (Exception ex) {
            throw new IOException(step + ": KeyFactory generatePublic failed"
                    + " (modulus " + n.bitLength() + " bits, e=" + e + "): " + ex.getMessage(), ex);
        }
    }

    /** 金鑰檔不存在就產生 RSA 2048 存成 PKCS#8 PEM；存在就載入。回傳 {private, public}。
     * 公鑰一律從金鑰檔的 DER 位元組解析（parsePkcs8／parsePkcs1），絕不從私鑰物件推導：
     * 不呼叫 getKeySpec、不讀私鑰物件的 getEncoded、不做任何轉型。Conscrypt 回傳非 CRT
     * 物件（getKeySpec 丟 RSAPrivateKeySpec、getEncoded 缺 publicExponent）的電視上也照樣可用；
     * 舊版只存了私鑰 PKCS#8 的金鑰檔照樣能讀。私鑰物件只用於簽章（Cipher RSA/ECB/NoPadding）。 */
    public static KeyPair loadOrGenerateKey(File f) throws Exception {
        if (f.exists()) {
            String pem;
            try {
                pem = readAll(f);
            } catch (IOException e) {
                throw new IOException("load key file " + f + ": read failed: " + e.getMessage(), e);
            }
            PemDer pd;
            try {
                pd = pemToDer(pem);
            } catch (IOException e) {
                throw new IOException("load key file " + f + ": " + e.getMessage(), e);
            }
            PrivateKey priv = loadPrivateKey(pem); // 內部錯誤已帶步驟（generatePrivate 失敗時）
            PublicKey pub = publicKeyFromDer(pd.der, pd.pkcs1);
            return new KeyPair(pub, priv);
        }
        KeyPairGenerator g = KeyPairGenerator.getInstance("RSA");
        g.initialize(2048);
        KeyPair kp = g.generateKeyPair();
        // getEncoded() 只用於把私鑰寫檔持久化，不用於推導公鑰參數。
        byte[] enc = kp.getPrivate().getEncoded();
        if (enc == null || enc.length == 0) {
            throw new IOException(
                    "generate key: private getEncoded() empty, cannot persist key file " + f);
        }
        String b64 = Base64.getMimeEncoder(64, new byte[] { '\n' }).encodeToString(enc);
        try {
            writeAll(f, "-----BEGIN PRIVATE KEY-----\n" + b64 + "\n-----END PRIVATE KEY-----\n");
        } catch (IOException e) {
            throw new IOException(
                    "generate key: write key file " + f + " failed: " + e.getMessage(), e);
        }
        // 產生後立刻把剛寫入的檔案重新讀回並解析：產生與載入兩條路徑得到相同公鑰。
        PemDer pd = pemToDer(readAll(f));
        PublicKey pub = publicKeyFromDer(pd.der, pd.pkcs1);
        return new KeyPair(pub, kp.getPrivate());
    }

    /** 僅供離線測試相容（既有測試呼叫）；App 正式路徑（loadOrGenerateKey）不呼叫此方法。
     * 從 priv.getEncoded() 的 PKCS#8 DER 解析：不呼叫 getKeySpec、不做任何轉型。
     * 注意：Conscrypt 非 CRT 金鑰物件的 getEncoded() 可能缺 publicExponent，此時丟出具體錯誤
     * （哪一步、哪個欄位）而非 ClassCastException；電視正式路徑不受影響（走檔案 DER）。 */
    static PublicKey publicKeyFromPrivate(PrivateKey priv) throws Exception {
        byte[] enc;
        try {
            enc = priv.getEncoded();
        } catch (Exception e) {
            throw new IOException("publicKeyFromPrivate: private getEncoded() threw "
                    + e.getClass().getName() + ": " + e.getMessage(), e);
        }
        if (enc == null || enc.length == 0) {
            throw new IOException("publicKeyFromPrivate: private getEncoded() empty"
                    + " (provider class " + priv.getClass().getName() + ")");
        }
        RSAPrivateCrtKeySpec spec;
        try {
            spec = parsePkcs8(enc);
        } catch (IOException e) {
            throw new IOException("publicKeyFromPrivate: parse PKCS#8 DER from key object failed"
                    + " (" + enc.length + " bytes, provider " + priv.getClass().getName() + "): "
                    + e.getMessage(), e);
        }
        try {
            return publicKeyFromCrt(spec, "publicKeyFromPrivate(" + priv.getClass().getName() + ")");
        } catch (IOException e) {
            throw new IOException(e.getMessage(), e);
        }
    }

    /** 最小 DER 解析：PKCS#8（外層 SEQUENCE 包著內層 PKCS#1 OCTET STRING），回傳內層 CRT 參數。
     * 失敗訊息帶欄位名與位移；原始例外一律鏈住（cause），不吞 suppressed。 */
    static RSAPrivateCrtKeySpec parsePkcs8(byte[] pkcs8) throws IOException {
        int[] pos = new int[] { 0 };
        expectTag(pkcs8, pos, 0x30, "PKCS#8 outer SEQUENCE");
        readLen(pkcs8, pos, "PKCS#8 outer length");
        expectTag(pkcs8, pos, 0x02, "PKCS#8 version INTEGER");
        int vn = readLen(pkcs8, pos, "PKCS#8 version length");
        if (vn < 0 || pos[0] + vn > pkcs8.length) {
            throw new IOException("PKCS#8 version overruns input"
                    + " (need " + vn + " bytes at offset " + pos[0] + ", total " + pkcs8.length + ")");
        }
        pos[0] += vn;
        expectTag(pkcs8, pos, 0x30, "PKCS#8 AlgorithmIdentifier SEQUENCE");
        int an = readLen(pkcs8, pos, "PKCS#8 AlgorithmIdentifier length");
        if (an < 0 || pos[0] + an > pkcs8.length) {
            throw new IOException("PKCS#8 AlgorithmIdentifier overruns input"
                    + " (need " + an + " bytes at offset " + pos[0] + ", total " + pkcs8.length + ")");
        }
        pos[0] += an;
        expectTag(pkcs8, pos, 0x04, "PKCS#8 privateKey OCTET STRING");
        int innerLen = readLen(pkcs8, pos, "PKCS#8 privateKey length");
        if (innerLen < 0 || pos[0] + innerLen > pkcs8.length) {
            throw new IOException("PKCS#8 privateKey length bad"
                    + " (innerLen=" + innerLen + " at offset " + pos[0]
                    + ", total " + pkcs8.length + ")");
        }
        byte[] inner = new byte[innerLen];
        System.arraycopy(pkcs8, pos[0], inner, 0, innerLen);
        try {
            return parsePkcs1(inner);
        } catch (IOException e) {
            throw new IOException("PKCS#8 inner PKCS#1 parse failed: " + e.getMessage(), e);
        }
    }

    static final String[] PKCS1_FIELDS = { "version", "modulus n", "publicExponent e",
        "privateExponent d", "prime1 p", "prime2 q", "exponent1 dp", "exponent2 dq",
        "coefficient qinv" };

    /** 最小 DER 解析：PKCS#1 RSAPrivateKey（9 個 INTEGER）。失敗訊息帶欄位名與位移。 */
    static RSAPrivateCrtKeySpec parsePkcs1(byte[] der) throws IOException {
        int[] pos = new int[] { 0 };
        expectTag(der, pos, 0x30, "PKCS#1 SEQUENCE");
        readLen(der, pos, "PKCS#1 SEQUENCE length");
        BigInteger[] v = new BigInteger[9];
        for (int i = 0; i < 9; i++) {
            String field = "PKCS#1 field[" + i + "] " + PKCS1_FIELDS[i];
            expectTag(der, pos, 0x02, field);
            int n = readLen(der, pos, field + " length");
            if (n < 0 || pos[0] + n > der.length) {
                throw new IOException(field + " overruns input"
                        + " (need " + n + " bytes at offset " + pos[0] + ", total " + der.length + ")");
            }
            byte[] raw = new byte[n];
            System.arraycopy(der, pos[0], raw, 0, n);
            pos[0] += n;
            v[i] = new BigInteger(raw);
        }
        return new RSAPrivateCrtKeySpec(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]);
    }

    private static void expectTag(byte[] der, int[] pos, int tag, String what) throws IOException {
        if (pos[0] >= der.length) {
            throw new IOException(what + ": unexpected end of input at offset " + pos[0]
                    + " (total " + der.length + ")");
        }
        int got = der[pos[0]++] & 0xff;
        if (got != tag) {
            throw new IOException(what + ": bad tag 0x" + Integer.toHexString(got)
                    + ", want 0x" + Integer.toHexString(tag) + " at offset " + (pos[0] - 1));
        }
    }

    private static int readLen(byte[] der, int[] pos, String what) throws IOException {
        if (pos[0] >= der.length) {
            throw new IOException(what + ": unexpected end of input at offset " + pos[0]
                    + " (total " + der.length + ")");
        }
        int b = der[pos[0]++] & 0xff;
        if (b < 0x80) {
            return b;
        }
        int n = b & 0x7f;
        if (n <= 0 || n > 4 || pos[0] + n > der.length) {
            throw new IOException(what + ": bad length prefix 0x" + Integer.toHexString(b)
                    + " at offset " + (pos[0] - 1) + " (total " + der.length + ")");
        }
        int len = 0;
        for (int i = 0; i < n; i++) {
            len = (len << 8) | (der[pos[0]++] & 0xff);
        }
        return len;
    }

    /** Android adb 格式公鑰本體：524 bytes mincrypt 結構（len=64、n0inv、n 小端、rr、e）。
     * n、e 優先經 RSAPublicKey 介面直接取得（Conscrypt 有實作，見工單要求 2；
     * instanceof 永不丟例外，後面的轉型因已檢查而安全），非 RSAPublicKey 實作才走
     * KeyFactory.getKeySpec(RSAPublicKeySpec)。全程不碰私鑰、不轉型私鑰。 */
    public static byte[] mincryptPublicKey(PublicKey pub) throws Exception {
        BigInteger n;
        BigInteger e;
        if (pub instanceof RSAPublicKey) {
            RSAPublicKey rsa = (RSAPublicKey) pub;
            n = rsa.getModulus();
            e = rsa.getPublicExponent();
        } else {
            RSAPublicKeySpec spec =
                    KeyFactory.getInstance("RSA").getKeySpec(pub, RSAPublicKeySpec.class);
            n = spec.getModulus();
            e = spec.getPublicExponent();
        }
        long n32 = n.and(BigInteger.valueOf(0xffffffffL)).longValue();
        long x = 1; // Newton 求 n mod 2^32 的反元素
        for (int i = 0; i < 5; i++) {
            x = (x * (2 - n32 * x)) & 0xffffffffL;
        }
        long n0inv = (0x100000000L - x) & 0xffffffffL;
        BigInteger rr = BigInteger.ONE.shiftLeft(4096).mod(n);
        ByteBuffer b = ByteBuffer.allocate(524).order(ByteOrder.LITTLE_ENDIAN);
        b.putInt(64);
        b.putInt((int) n0inv);
        b.put(toLittleEndian256(n));
        b.put(toLittleEndian256(rr));
        b.putInt(e.intValue());
        return b.array();
    }

    static byte[] toLittleEndian256(BigInteger v) {
        byte[] be = v.toByteArray();
        int start = 0;
        while (be.length - start > 256) {
            start++; // 不應發生（2048 位元）；防呆
        }
        if (be.length - start > 0 && be[start] == 0 && be.length - start == 257) {
            start++;
        }
        byte[] le = new byte[256];
        int n = be.length - start;
        for (int i = 0; i < n && i < 256; i++) {
            le[i] = be[be.length - 1 - i];
        }
        return le;
    }

    /** "base64(524 bytes) tvagent@tv"；送給 adbd 時尾端再加一個 \0。 */
    public static String adbPublicKeyString(PublicKey pub) throws Exception {
        return Base64.getEncoder().encodeToString(mincryptPublicKey(pub)) + " " + PUBKEY_COMMENT;
    }

    /**
     * 對 20 bytes token 簽章：EM = 00 01 FF.. 00 || DigestInfo(SHA-1, token)，
     * 再做 RSA 私鑰運算（確定性，等同 RSA_sign(NID_sha1)；不用 SHA1withRSA，
     * 那會先把 token 再雜湊一次，結果不同）。
     */
    public static byte[] signToken(PrivateKey priv, byte[] token) throws Exception {
        if (token.length != 20) {
            throw new IOException("token must be 20 bytes");
        }
        int diLen = DIGEST_INFO_PREFIX.length + 20;
        byte[] em = new byte[256];
        em[0] = 0x00;
        em[1] = 0x01;
        for (int i = 2; i < 256 - diLen - 1; i++) {
            em[i] = (byte) 0xff;
        }
        em[256 - diLen - 1] = 0x00;
        System.arraycopy(DIGEST_INFO_PREFIX, 0, em, 256 - diLen, DIGEST_INFO_PREFIX.length);
        System.arraycopy(token, 0, em, 256 - 20, 20);
        Cipher c = Cipher.getInstance("RSA/ECB/NoPadding");
        c.init(Cipher.ENCRYPT_MODE, priv);
        return c.doFinal(em);
    }

    static String readAll(File f) throws IOException {
        FileInputStream fis = new FileInputStream(f);
        try {
            ByteArrayOutputStream b = new ByteArrayOutputStream();
            byte[] tmp = new byte[8192];
            int n;
            while ((n = fis.read(tmp)) >= 0) {
                b.write(tmp, 0, n);
            }
            return new String(b.toByteArray(), StandardCharsets.UTF_8);
        } finally {
            fis.close();
        }
    }

    static void writeAll(File f, String s) throws IOException {
        FileOutputStream fos = new FileOutputStream(f);
        try {
            fos.write(s.getBytes(StandardCharsets.UTF_8));
        } finally {
            fos.close();
        }
    }

    // ---- 連線 ----

    private final String host;
    private final int port;
    private final PrivateKey priv;
    private final PublicKey pub;
    private long authTimeoutMs = 60000;
    private long ioTimeoutMs = 10000;

    private Socket sock;
    private DataInputStream in;
    private OutputStream out;
    private long peerVersion = -1;
    private int peerMaxdata = MAXDATA;
    private int nextLocalId = 1;

    public AdbClient(String host, int port, PrivateKey priv, PublicKey pub) {
        this.host = host;
        this.port = port;
        this.priv = priv;
        this.pub = pub;
    }

    public static AdbClient withKeyFile(String host, int port, File keyFile) throws Exception {
        KeyPair kp = loadOrGenerateKey(keyFile);
        return new AdbClient(host, port, kp.getPrivate(), kp.getPublic());
    }

    public void setAuthTimeoutMs(long ms) {
        authTimeoutMs = ms;
    }

    public void setIoTimeoutMs(long ms) {
        ioTimeoutMs = ms;
    }

    /** 執行一條 shell 指令並回傳完整輸出（多個 WRTE 會拼接）。 */
    public String shell(String command) throws AdbException {
        try {
            connect();
        } catch (SocketTimeoutException e) {
            throw new AdbException(CONNECT, "connect timed out: " + e.getMessage(), e);
        } catch (IOException e) {
            throw new AdbException(CONNECT, "connect failed: " + e.getMessage(), e);
        }
        try {
            authenticate();
            return openShell(command);
        } finally {
            closeQuietly();
        }
    }

    private void connect() throws IOException {
        sock = new Socket();
        sock.connect(new InetSocketAddress(host, port), (int) Math.min(ioTimeoutMs, 60000));
        sock.setSoTimeout((int) Math.min(ioTimeoutMs, 60000));
        in = new DataInputStream(sock.getInputStream());
        out = sock.getOutputStream();
    }

    private void closeQuietly() {
        try {
            if (sock != null) {
                sock.close();
            }
        } catch (IOException ignored) {
            // 關閉失敗不用回報
        }
        sock = null;
    }

    private void send(int cmd, int arg0, int arg1, byte[] payload) throws AdbException {
        if (payload.length > peerMaxdata) {
            throw new AdbException(PROTOCOL, "payload " + payload.length
                    + " exceeds peer maxdata " + peerMaxdata);
        }
        try {
            writeMessage(out, cmd, arg0, arg1, payload);
        } catch (IOException e) {
            throw new AdbException(IO, "send failed: " + e.getMessage(), e);
        }
    }

    private Msg recv() throws IOException, AdbException {
        return readMessage(in, peerVersion);
    }

    private void authenticate() throws AdbException {
        send(CMD_CNXN, VERSION, MAXDATA, "host::tvagent\0".getBytes(StandardCharsets.UTF_8));
        long deadline = System.currentTimeMillis() + authTimeoutMs;
        byte[] pubkeyPayload = null;
        int tokenCount = 0;
        for (;;) {
            Msg m;
            try {
                m = recv();
            } catch (SocketTimeoutException e) {
                if (System.currentTimeMillis() >= deadline) {
                    throw new AdbException(AUTH_TIMEOUT, "waiting for auth CNXN timed out");
                }
                continue;
            } catch (EOFException e) {
                throw new AdbException(AUTH_REJECTED, "disconnected during auth");
            } catch (SocketException e) {
                throw new AdbException(AUTH_REJECTED, "disconnected during auth: " + e.getMessage());
            } catch (AdbException e) {
                throw e;
            } catch (IOException e) {
                throw new AdbException(IO, "io during auth: " + e.getMessage(), e);
            }
            if (m.cmd == CMD_STLS) {
                throw new AdbException(TLS_REQUIRED, "server requires TLS");
            }
            if (m.cmd == CMD_CNXN) {
                peerVersion = m.arg0 & 0xffffffffL;
                if (m.arg1 <= 0) {
                    throw new AdbException(PROTOCOL, "bad peer maxdata " + m.arg1);
                }
                peerMaxdata = m.arg1;
                return; // 認證完成
            }
            if (m.cmd == CMD_AUTH && m.arg0 == AUTH_TOKEN) {
                if (m.payload.length != 20) {
                    throw new AdbException(PROTOCOL, "bad token length " + m.payload.length);
                }
                tokenCount++;
                try {
                    if (tokenCount == 2) {
                        if (pubkeyPayload == null) {
                            String s = adbPublicKeyString(pub);
                            pubkeyPayload = (s + "\0").getBytes(StandardCharsets.UTF_8);
                        }
                        send(CMD_AUTH, AUTH_RSAPUBLICKEY, 0, pubkeyPayload);
                    } else {
                        send(CMD_AUTH, AUTH_SIGNATURE, 0, signToken(priv, m.payload));
                    }
                } catch (AdbException e) {
                    throw e;
                } catch (Exception e) {
                    throw new AdbException(IO, "sign failed: " + e.getMessage(), e);
                }
                if (System.currentTimeMillis() >= deadline) {
                    throw new AdbException(AUTH_TIMEOUT, "auth timed out");
                }
                continue;
            }
            if (m.cmd == CMD_CLSE) {
                throw new AdbException(AUTH_REJECTED, "closed during auth");
            }
            throw new AdbException(PROTOCOL, "unexpected " + cmdName(m.cmd) + " during auth");
        }
    }

    private String openShell(String command) throws AdbException {
        int local = nextLocalId++;
        byte[] req = ("shell:" + command + "\0").getBytes(StandardCharsets.UTF_8);
        send(CMD_OPEN, local, 0, req);
        int remote = -1;
        ByteArrayOutputStream buf = new ByteArrayOutputStream();
        for (;;) {
            Msg m;
            try {
                m = recv();
            } catch (SocketTimeoutException e) {
                throw new AdbException(IO, "shell timed out");
            } catch (EOFException e) {
                throw new AdbException(IO, "disconnected during shell");
            } catch (AdbException e) {
                throw e;
            } catch (IOException e) {
                throw new AdbException(IO, "io during shell: " + e.getMessage(), e);
            }
            if (m.cmd == CMD_STLS) {
                throw new AdbException(TLS_REQUIRED, "server requires TLS");
            }
            if (m.cmd == CMD_OKAY && m.arg1 == local) {
                remote = m.arg0;
                continue;
            }
            if (m.cmd == CMD_WRTE && m.arg1 == local && (remote < 0 || m.arg0 == remote)) {
                if (remote < 0) {
                    remote = m.arg0;
                }
                buf.write(m.payload, 0, m.payload.length);
                send(CMD_OKAY, local, remote, EMPTY);
                continue;
            }
            if (m.cmd == CMD_CLSE && (m.arg1 == local || m.arg0 == remote)) {
                try {
                    send(CMD_CLSE, local, remote < 0 ? 0 : remote, EMPTY);
                } catch (AdbException ignored) {
                    // 回 CLSE 失敗不影響已收到的輸出
                }
                return new String(buf.toByteArray(), StandardCharsets.UTF_8);
            }
            throw new AdbException(PROTOCOL, "unexpected " + cmdName(m.cmd) + " during shell");
        }
    }

    /**
     * 供 Docker／Mac 單獨使用（電視上不用）：java AdbClient host port keyfile shell指令…
     * 金鑰檔不存在就產生。成功印指令輸出；失敗印「類別: 訊息」並以非 0 結束。
     */
    public static void main(String[] args) {
        if (args.length < 4) {
            System.err.println("usage: AdbClient <host> <port> <keyfile> <shell command...>");
            System.exit(2);
            return;
        }
        StringBuilder cmd = new StringBuilder();
        for (int i = 3; i < args.length; i++) {
            if (i > 3) {
                cmd.append(' ');
            }
            cmd.append(args[i]);
        }
        try {
            AdbClient c = withKeyFile(args[0], Integer.parseInt(args[1]), new File(args[2]));
            System.out.print(c.shell(cmd.toString()));
        } catch (AdbException e) {
            System.err.println(e.kind + ": " + e.getMessage());
            System.exit(1);
        } catch (Exception e) {
            System.err.println(IO + ": " + e.getMessage());
            System.exit(1);
        }
    }
}
package com.example.tvagent;

import android.app.AlarmManager;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Context;
import android.content.Intent;
import android.os.Build;
import android.os.IBinder;
import android.os.Process;
import android.os.SystemClock;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/**
 * 前景服務：所有 adb 動作都在同一個單執行緒上序列化。
 * 心跳由 AlarmManager 精確鬧鐘驅動，每 60 秒一次（見 AlarmReceiver）：
 * 連本機 adbd 跑 echo ok，寫進 files/agent.log。
 * TCL 的 FreezeManager 會凍結閒置程序（含前景服務），
 * ScheduledExecutorService 的週期心跳因此停擺；改用鬧鐘＋廣播喚醒
 * （收到廣播時系統會解凍該程序）。executor 只留單次工作佇列。
 * SELFTEST 也排進同一條執行緒，不和心跳並行。
 *
 * 電視上可觸發的只有固定的心跳與 SELFTEST；沒有任何從 Intent extra
 * 或檔案讀入指令的路徑。
 */
public class AgentService extends Service {

    static final String EXTRA_REASON = "reason";
    static final String EXTRA_SELFTEST = "selftest";
    static final String SELFTEST_ACTION = "com.example.tvagent.SELFTEST";
    static final String HEARTBEAT_ACTION = "com.example.tvagent.HEARTBEAT";

    static final long HEARTBEAT_MS = 60 * 1000;
    static final long DEDUP_MS = 30 * 1000;
    static final int ALARM_REQ = 1;

    static final String TARGET = "com.example.tkey";
    static final String CMD_ECHO = "echo ok";
    static final String WHITELIST = "com.android.bluetooth,com.tcl.tvinput,com.tcl.autopair,com.google.android.katniss,com.tcl.ttvs,com.tcl.versionUpdateApp,com.tcl.usagestats,com.tcl.MultiScreenInteraction_TV,com.example.tvagent";
    static final String CMD_WHITELIST = "S=com.tcl.guard/.memorymanager.TGuardService; "
            + "dumpsys activity service $S 2>/dev/null | grep -q 'KillWhiteList:.*com[.]example[.]tvagent$' && echo keep || { "
            + "dumpsys activity service $S mKillWhiteList '" + WHITELIST + "' >/dev/null 2>/dev/null; "
            + "dumpsys activity service $S 2>/dev/null | grep -q 'KillWhiteList:.*com[.]example[.]tvagent$' && echo set || echo fail; }";
    static final String CMD_DISABLE = "pm disable-user --user 0 com.example.tkey";
    static final String CMD_LIST_DISABLED = "pm list packages -d";
    static final String CMD_ENABLE = "pm enable com.example.tkey";

    static final String HOST = "127.0.0.1";
    static final int PORT = 5555;
    static final long AUTH_TIMEOUT_MS = 60000;
    static final long IO_TIMEOUT_MS = 10000;

    private ExecutorService exec;
    private File logFile;
    private File keyFile;
    // 上次實際寫下心跳的 elapsedRealtime（毫秒）；凍結後補跑導致
    // 密集重複時，距上次 < DEDUP_MS 就略過，避免同一分鐘寫兩次。
    private volatile long lastHeartbeatElapsed = 0;

    @Override
    public void onCreate() {
        super.onCreate();
        startAsForeground();
        logFile = new File(getFilesDir(), "agent.log");
        keyFile = new File(getFilesDir(), "adbkey");
        // 單次工作佇列：心跳與 SELFTEST 都排進這裡序列化，不再做週期排程。
        exec = Executors.newSingleThreadExecutor();
    }

    /**
     * 排下一次鬧鐘（精確鬧鐘，每次觸發後由服務重新排下一次）。
     * PendingIntent 用固定 requestCode＋FLAG_UPDATE_CURRENT，
     * 同一時間只會有一個待發鬧鐘。API 26～30 用
     * setExactAndAllowWhileIdle，不需要 SCHEDULE_EXACT_ALARM 權限。
     */
    static void scheduleNextAlarm(Context ctx) {
        AlarmManager am = (AlarmManager) ctx.getSystemService(Context.ALARM_SERVICE);
        if (am == null) {
            return;
        }
        Intent i = new Intent(ctx, AlarmReceiver.class);
        int flags = PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE;
        PendingIntent pi = PendingIntent.getBroadcast(ctx, ALARM_REQ, i, flags);
        long next = SystemClock.elapsedRealtime() + HEARTBEAT_MS;
        am.setExactAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, next, pi);
    }

    private void startAsForeground() {
        String ch = "tvagent";
        if (Build.VERSION.SDK_INT >= 26) {
            NotificationChannel nc = new NotificationChannel(
                    ch, "tvagent 實驗", NotificationManager.IMPORTANCE_LOW);
            NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
            if (nm != null) {
                nm.createNotificationChannel(nc);
            }
        }
        Notification n;
        if (Build.VERSION.SDK_INT >= 26) {
            n = new Notification.Builder(this, ch)
                    .setContentTitle("tvagent 實驗")
                    .setContentText("adb 心跳執行中")
                    .setSmallIcon(android.R.drawable.stat_notify_sync)
                    .build();
        } else {
            n = new Notification.Builder(this)
                    .setContentTitle("tvagent 實驗")
                    .setContentText("adb 心跳執行中")
                    .setSmallIcon(android.R.drawable.stat_notify_sync)
                    .build();
        }
        startForeground(1, n);
    }

    @Override
    public int onStartCommand(final Intent intent, int flags, int startId) {
        // 立刻確保前景狀態（若系統重建服務時 intent 為 null 也要能撐住）。
        try {
            startAsForeground();
        } catch (Exception ignored) {
            // 已經是前景時重複呼叫無害
        }
        // 鬧鐘心跳：排一次心跳進單執行緒，並排下一次鬧鐘；
        // 服務若曾被殺，這裡的 startForegroundService 會把它重建。
        if (intent != null && HEARTBEAT_ACTION.equals(intent.getAction())) {
            if (exec != null) {
                exec.execute(new Runnable() {
                    @Override
                    public void run() {
                        heartbeat("alarm");
                    }
                });
            }
            scheduleNextAlarm(this);
            return START_STICKY;
        }
        String reason = "other";
        boolean wantSelftest = false;
        if (intent != null) {
            String r = intent.getStringExtra(EXTRA_REASON);
            if ("boot".equals(r) || "test".equals(r)) {
                reason = r;
            }
            wantSelftest = intent.getBooleanExtra(EXTRA_SELFTEST, false);
        }
        final String logReason = reason;
        // start 行由主執行緒直接寫，避免和背景工作搶順序造成混淆。
        logLine("start reason=" + logReason);
        // 服務啟動（boot／test／other，含系統重建時的 null intent）
        // 都要確保下一次鬧鐘已排好，並先做一次心跳（src=start）。
        scheduleNextAlarm(this);
        if (exec != null) {
            exec.execute(new Runnable() {
                @Override
                public void run() {
                    heartbeat("start");
                }
            });
            if (wantSelftest) {
                exec.execute(new Runnable() {
                    @Override
                    public void run() {
                        runSelftest();
                    }
                });
            }
        }
        return START_STICKY;
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    @Override
    public void onDestroy() {
        if (exec != null) {
            exec.shutdownNow();
            exec = null;
        }
        super.onDestroy();
    }

    private String runAdb(String cmd) throws AdbClient.AdbException {
        try {
            AdbClient c = AdbClient.withKeyFile(HOST, PORT, keyFile);
            c.setAuthTimeoutMs(AUTH_TIMEOUT_MS);
            c.setIoTimeoutMs(IO_TIMEOUT_MS);
            return c.shell(cmd);
        } catch (AdbClient.AdbException e) {
            throw e;
        } catch (Exception e) {
            throw new AdbClient.AdbException(AdbClient.IO, "key error: " + e.getMessage());
        }
    }

    private void heartbeat(String src) {
        // 凍結期間被略過的心跳可能在解凍時補跑：距上次 < 30 秒就略過，
        // 同一分鐘內不重複寫兩次。心跳都在單執行緒上跑，不會有並行問題。
        long now = SystemClock.elapsedRealtime();
        if (now - lastHeartbeatElapsed < DEDUP_MS) {
            return;
        }
        lastHeartbeatElapsed = now;
        String status;
        try {
            String output = runAdb(CMD_ECHO);
            status = output.trim().equals("ok") ? "ok" : "io:unexpected-output";
        } catch (AdbClient.AdbException e) {
            status = e.kind + ":" + oneLine(e.getMessage());
        } catch (Exception e) {
            status = AdbClient.IO + ":" + oneLine(e.getMessage());
        }
        String wl = "skip";
        if ("ok".equals(status)) {
            try {
                wl = Whitelist.wlStatus(runAdb(CMD_WHITELIST));
            } catch (AdbClient.AdbException e) {
                wl = e.kind + ":" + oneLine(e.getMessage());
            } catch (Exception e) {
                wl = AdbClient.IO + ":" + oneLine(e.getMessage());
            }
        }
        long uptime = SystemClock.elapsedRealtime() / 1000;
        logLine("uptime=" + uptime + " pid=" + Process.myPid() + " src=" + src + " adb=" + status + " wl=" + wl);
    }

    private void runSelftest() {
        // 0. 先確認有授權（必要時等授權）；沒有就結束。
        try {
            String echo = runAdb(CMD_ECHO);
            if (!echo.trim().equals("ok")) {
                logLine("selftest FAIL auth");
                return;
            }
        } catch (AdbClient.AdbException e) {
            logLine("selftest FAIL auth");
            return;
        }
        // 開始前檢查：tkey 已停用就不動。
        try {
            if (runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                logLine("selftest SKIP tkey-disabled");
                return;
            }
        } catch (AdbClient.AdbException e) {
            logLine("selftest FAIL 0");
            tryEnable();
            return;
        }
        int fail = -1;
        // 1. 停用
        try {
            runAdb(CMD_DISABLE);
        } catch (AdbClient.AdbException e) {
            fail = 1;
        }
        // 2. 確認出現在停用清單
        if (fail < 0) {
            try {
                if (!runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                    fail = 2;
                }
            } catch (AdbClient.AdbException e) {
                fail = 2;
            }
        }
        // 3. 啟用
        if (fail < 0) {
            try {
                runAdb(CMD_ENABLE);
            } catch (AdbClient.AdbException e) {
                fail = 3;
            }
        }
        // 4. 確認已不在停用清單
        if (fail < 0) {
            try {
                if (runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                    fail = 4;
                }
            } catch (AdbClient.AdbException e) {
                fail = 4;
            }
        }
        // 無論成敗都要嘗試恢復啟用。
        tryEnable();
        if (fail < 0) {
            logLine("selftest PASS");
        } else {
            logLine("selftest FAIL " + fail);
        }
    }

    private void tryEnable() {
        try {
            runAdb(CMD_ENABLE);
        } catch (Exception ignored) {
            // 恢復盡力而為
        }
    }

    private static String oneLine(String s) {
        if (s == null) {
            return "";
        }
        return s.replace('\n', ' ').replace('\r', ' ').trim();
    }

    synchronized void logLine(String msg) {
        String ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault())
                .format(new Date());
        FileWriter w = null;
        try {
            w = new FileWriter(logFile, true);
            w.write(ts + " " + msg + "\n");
        } catch (IOException ignored) {
            // 寫 log 失敗不影響主流程
        } finally {
            if (w != null) {
                try {
                    w.close();
                } catch (IOException ignored) {
                    // 忽略
                }
            }
        }
    }
}
package com.example.tvagent;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;

/**
 * 鬧鐘心跳接收器：由 AlarmManager 每 60 秒用精確鬧鐘喚醒（明確廣播，
 * exported=false）。收到後只負責把服務叫起來（action HEARTBEAT）；
 * 自己不做任何 adb 動作。TCL 的 FreezeManager 會凍結閒置程序，
 * 但收到廣播時系統會立即解凍該程序，所以鬧鐘能穿透凍結。
 */
public class AlarmReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        Intent svc = new Intent(context, AgentService.class);
        svc.setAction(AgentService.HEARTBEAT_ACTION);
        BootReceiver.startServiceCompat(context, svc);
    }

    /** 保持向後相容的呼叫形狀（目前未使用，預留直接啟動服務用）。 */
    static void startServiceCompat(Context context, Intent svc) {
        BootReceiver.startServiceCompat(context, svc);
    }
}
package com.example.tvagent;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.Build;

/** 開機自啟：只負責把服務叫起來，所有 adb 動作都在服務內的單執行緒做。 */
public class BootReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        if (!Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) {
            return;
        }
        Intent svc = new Intent(context, AgentService.class);
        svc.putExtra(AgentService.EXTRA_REASON, "boot");
        startServiceCompat(context, svc);
    }

    static void startServiceCompat(Context context, Intent svc) {
        try {
            if (Build.VERSION.SDK_INT >= 26) {
                context.startForegroundService(svc);
            } else {
                context.startService(svc);
            }
        } catch (Exception e) {
            try {
                context.startService(svc);
            } catch (Exception ignored) {
                // 啟動失敗只能等下次廣播
            }
        }
    }
}
package com.example.tvagent;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;

/**
 * 自我測試入口：am broadcast -n com.example.tvagent/.TestReceiver
 * -a com.example.tvagent.SELFTEST。只負責確保服務在跑（reason=test）
 * 並把 SELFTEST 排進服務的單執行緒；自己不做任何 adb 動作。
 */
public class TestReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        if (!AgentService.SELFTEST_ACTION.equals(intent.getAction())) {
            return;
        }
        Intent svc = new Intent(context, AgentService.class);
        svc.putExtra(AgentService.EXTRA_REASON, "test");
        svc.putExtra(AgentService.EXTRA_SELFTEST, true);
        BootReceiver.startServiceCompat(context, svc);
    }
}
package com.example.tvagent;

final class Whitelist {
    static String wlStatus(String shellOutput) {
        String status = shellOutput.trim();
        status = status.substring(status.lastIndexOf('\n') + 1).trim();
        return "keep".equals(status) || "set".equals(status) || "fail".equals(status)
                ? status : "unexpected";
    }
}
package com.example.tvagent;

import java.io.ByteArrayOutputStream;
import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.EOFException;
import java.io.File;
import java.io.FileInputStream;
import java.io.OutputStream;
import java.math.BigInteger;
import java.net.ServerSocket;
import java.net.Socket;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.interfaces.RSAPrivateCrtKey;
import java.security.spec.RSAPublicKeySpec;
import java.util.Arrays;
import java.util.Base64;

/**
 * 離線協定測試（純 Java）：內建假 adbd（ServerSocket 127.0.0.1）。
 * 用法：java com.example.tvagent.AdbClientTest &lt;testdata 目錄&gt;
 * 最後一行印 ALL PASS；任一失敗以非 0 結束。
 */
public class AdbClientTest {

    static int failures = 0;

    static void check(boolean cond, String name, String detail) {
        if (cond) {
            System.out.println("PASS " + name);
        } else {
            System.out.println("FAIL " + name + " :: " + detail);
            failures++;
        }
    }

    // ---------- 小工具 ----------

    static byte[] readFile(File f) throws Exception {
        FileInputStream fis = new FileInputStream(f);
        try {
            ByteArrayOutputStream b = new ByteArrayOutputStream();
            byte[] tmp = new byte[8192];
            int n;
            while ((n = fis.read(tmp)) >= 0) {
                b.write(tmp, 0, n);
            }
            return b.toByteArray();
        } finally {
            fis.close();
        }
    }

    static int freePort() throws Exception {
        ServerSocket s = new ServerSocket(0);
        try {
            return s.getLocalPort();
        } finally {
            s.close();
        }
    }

    static String runClient(int port, PrivateKey priv, PublicKey pub, String cmd,
            long authMs, long ioMs) throws AdbClient.AdbException {
        AdbClient c = new AdbClient("127.0.0.1", port, priv, pub);
        c.setAuthTimeoutMs(authMs);
        c.setIoTimeoutMs(ioMs);
        return c.shell(cmd);
    }

    // ---------- 獨立驗算（不經過 AdbClient 的金鑰程式碼） ----------

    static final class ParsedKey {
        BigInteger n;
        BigInteger e;
    }

    static ParsedKey parseMincrypt(byte[] raw) throws Exception {
        if (raw.length != 524) {
            throw new Exception("pubkey raw length " + raw.length + " != 524");
        }
        ByteBuffer b = ByteBuffer.wrap(raw).order(ByteOrder.LITTLE_ENDIAN);
        int len = b.getInt();
        if (len != 64) {
            throw new Exception("len field " + len + " != 64");
        }
        long n0inv = b.getInt() & 0xffffffffL;
        byte[] nLe = new byte[256];
        byte[] rrLe = new byte[256];
        b.get(nLe);
        b.get(rrLe);
        int e = b.getInt();
        byte[] nBe = new byte[256];
        byte[] rrBe = new byte[256];
        for (int i = 0; i < 256; i++) {
            nBe[i] = nLe[255 - i];
            rrBe[i] = rrLe[255 - i];
        }
        BigInteger n = new BigInteger(1, nBe);
        BigInteger rr = new BigInteger(1, rrBe);
        BigInteger two32 = BigInteger.ONE.shiftLeft(32);
        if (!n.multiply(BigInteger.valueOf(n0inv)).mod(two32).equals(two32.subtract(BigInteger.ONE))) {
            throw new Exception("n0inv mismatch");
        }
        if (!BigInteger.ONE.shiftLeft(4096).mod(n).equals(rr)) {
            throw new Exception("rr mismatch");
        }
        ParsedKey k = new ParsedKey();
        k.n = n;
        k.e = BigInteger.valueOf(e & 0xffffffffL);
        return k;
    }

    static void verifySignature(byte[] sig, byte[] token, ParsedKey k) throws Exception {
        if (sig.length != 256) {
            throw new Exception("sig length " + sig.length);
        }
        BigInteger m = new BigInteger(1, sig).modPow(k.e, k.n);
        byte[] be = m.toByteArray();
        byte[] em = new byte[256];
        int copyFrom = Math.max(0, be.length - 256);
        int copyLen = Math.min(be.length, 256);
        System.arraycopy(be, copyFrom, em, 256 - copyLen, copyLen);
        byte[] prefix = {
            (byte) 0x30, (byte) 0x21, (byte) 0x30, (byte) 0x09,
            (byte) 0x06, (byte) 0x05, (byte) 0x2b, (byte) 0x0e,
            (byte) 0x03, (byte) 0x02, (byte) 0x1a, (byte) 0x05,
            (byte) 0x00, (byte) 0x04, (byte) 0x14,
        };
        int diLen = prefix.length + token.length;
        byte[] expect = new byte[256];
        expect[0] = 0x00;
        expect[1] = 0x01;
        Arrays.fill(expect, 2, 256 - diLen - 1, (byte) 0xff);
        expect[256 - diLen - 1] = 0x00;
        System.arraycopy(prefix, 0, expect, 256 - diLen, prefix.length);
        System.arraycopy(token, 0, expect, 256 - token.length, token.length);
        if (!Arrays.equals(em, expect)) {
            throw new Exception("sig^e mod n != PKCS#1 v1.5(SHA-1 DigestInfo || token)");
        }
    }

    // ---------- 假 adbd ----------

    static final class Fake {
        enum Auth {
            REJECT_FIRST, ACCEPT_FIRST, SILENT, CLOSE_AFTER_TOKEN, STLS,
            BAD_MAGIC, BAD_CHECKSUM, GARBAGE_CMD
        }

        enum Shell {
            ECHO_OK, BIG, TRUNCATED, NONE
        }

        final Auth auth;
        final Shell shell;
        final int version;
        final int maxdata;
        ParsedKey knownKey; // ACCEPT_FIRST 用：上一輪記下的公鑰
        byte[] bigOutput;

        ServerSocket ss;
        Thread thread;
        volatile String failure;
        volatile boolean sawPubkey;
        volatile ParsedKey capturedKey;
        volatile byte[] capturedSig1;
        volatile byte[] capturedToken1;

        Fake(Auth auth, Shell shell, int version, int maxdata) {
            this.auth = auth;
            this.shell = shell;
            this.version = version;
            this.maxdata = maxdata;
        }

        int start() throws Exception {
            ss = new ServerSocket(0, 1, java.net.InetAddress.getByName("127.0.0.1"));
            thread = new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        Socket s = ss.accept();
                        try {
                            handle(s);
                        } finally {
                            try {
                                s.close();
                            } catch (Exception ignored) {
                                // 關閉失敗不影響判定
                            }
                        }
                    } catch (Exception e) {
                        note("accept/handler: " + e);
                    }
                }
            });
            thread.setDaemon(true);
            thread.start();
            return ss.getLocalPort();
        }

        void awaitDone(long timeoutMs) throws Exception {
            thread.join(timeoutMs);
            try {
                ss.close();
            } catch (Exception ignored) {
                // 關閉失敗不影響判定
            }
        }

        void note(String f) {
            if (failure == null) {
                failure = f;
            }
        }

        void expect(boolean cond, String what) {
            if (!cond) {
                note(what);
                throw new RuntimeException(what);
            }
        }

        void checkCap(AdbClient.Msg m, String what) {
            expect(m.payload.length <= maxdata,
                    what + " payload " + m.payload.length + " exceeds maxdata " + maxdata);
        }

        static void writeRawHeader(OutputStream out, int cmd, int a0, int a1,
                int len, int cksum, int magic) throws Exception {
            ByteBuffer h = ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
            h.putInt(cmd);
            h.putInt(a0);
            h.putInt(a1);
            h.putInt(len);
            h.putInt(cksum);
            h.putInt(magic);
            out.write(h.array());
            out.flush();
        }

        void handle(Socket s) throws Exception {
            s.setSoTimeout(10000);
            DataInputStream in = new DataInputStream(s.getInputStream());
            OutputStream out = s.getOutputStream();

            AdbClient.Msg hello;
            try {
                hello = AdbClient.readMessage(in, -1);
            } catch (Exception e) {
                note("reading client CNXN: " + e);
                return;
            }
            try {
                expect(hello.cmd == AdbClient.CMD_CNXN, "first must be CNXN");
                checkCap(hello, "client CNXN");
            } catch (RuntimeException e) {
                return;
            }

            byte[] devId = "device::\0".getBytes(StandardCharsets.UTF_8);
            if (auth == Auth.BAD_MAGIC) {
                writeRawHeader(out, AdbClient.CMD_CNXN, version, maxdata, 0, 0, 0x12345678);
                return;
            }
            if (auth == Auth.BAD_CHECKSUM) {
                ByteBuffer h = ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
                h.putInt(AdbClient.CMD_CNXN);
                h.putInt(version);
                h.putInt(maxdata);
                h.putInt(devId.length);
                h.putInt(AdbClient.checksum(devId, devId.length) + 1); // 故意寫錯
                h.putInt(AdbClient.CMD_CNXN ^ 0xffffffff);
                out.write(h.array());
                out.write(devId);
                out.flush();
                return;
            }
            if (auth == Auth.STLS) {
                AdbClient.writeMessage(out, AdbClient.CMD_STLS, 0, 0, AdbClient.EMPTY);
                return;
            }
            if (auth == Auth.GARBAGE_CMD) {
                AdbClient.writeMessage(out, AdbClient.CMD_OKAY, 1, 2, AdbClient.EMPTY);
                return;
            }
            if (auth == Auth.SILENT) {
                // 真 adbd 未授權時只回 AUTH TOKEN（不會先回 CNXN）；沉默即一個都不回。
                try {
                    AdbClient.readMessage(in, 0x01000000L); // 等客戶端自己放棄並斷線
                } catch (Exception ignored) {
                    // 客戶端斷線是預期行為
                }
                return;
            }

            byte[] token1 = new byte[20];
            for (int i = 0; i < 20; i++) {
                token1[i] = (byte) (i + 1);
            }
            byte[] token2 = new byte[20];
            for (int i = 0; i < 20; i++) {
                token2[i] = (byte) (0x51 + i);
            }
            AdbClient.writeMessage(out, AdbClient.CMD_AUTH, AdbClient.AUTH_TOKEN, 0, token1);
            if (auth == Auth.CLOSE_AFTER_TOKEN) {
                s.close();
                return;
            }

            AdbClient.Msg sig1;
            try {
                sig1 = AdbClient.readMessage(in, version);
                expect(sig1.cmd == AdbClient.CMD_AUTH && sig1.arg0 == AdbClient.AUTH_SIGNATURE,
                        "expect SIGNATURE, got " + AdbClient.cmdName(sig1.cmd));
                checkCap(sig1, "client SIGNATURE");
                expect(sig1.payload.length == 256, "sig length " + sig1.payload.length);
            } catch (RuntimeException e) {
                return;
            }

            if (auth == Auth.ACCEPT_FIRST) {
                try {
                    expect(knownKey != null, "no known key for round 2");
                    verifySignature(sig1.payload, token1, knownKey);
                    AdbClient.writeMessage(out, AdbClient.CMD_CNXN, version, maxdata, devId);
                } catch (Exception e) {
                    note("round2 verify: " + e.getMessage());
                    return;
                }
            } else {
                // 拒絕第一輪簽章，要求送公鑰
                AdbClient.writeMessage(out, AdbClient.CMD_AUTH, AdbClient.AUTH_TOKEN, 0, token2);
                AdbClient.Msg pub;
                try {
                    pub = AdbClient.readMessage(in, version);
                    expect(pub.cmd == AdbClient.CMD_AUTH
                            && pub.arg0 == AdbClient.AUTH_RSAPUBLICKEY,
                            "expect RSAPUBLICKEY, got " + AdbClient.cmdName(pub.cmd));
                    checkCap(pub, "client RSAPUBLICKEY");
                    expect(pub.payload.length > 0
                            && pub.payload[pub.payload.length - 1] == 0,
                            "RSAPUBLICKEY must end with NUL");
                    sawPubkey = true;
                    byte[] raw = Base64.getDecoder().decode(new String(pub.payload, 0,
                            pub.payload.length - 1, StandardCharsets.US_ASCII).split(" ")[0]);
                    capturedKey = parseMincrypt(raw);
                    capturedToken1 = token1;
                    capturedSig1 = sig1.payload;
                    verifySignature(sig1.payload, token1, capturedKey);
                    AdbClient.writeMessage(out, AdbClient.CMD_CNXN, version, maxdata, devId);
                } catch (RuntimeException e) {
                    return;
                } catch (Exception e) {
                    note("pubkey/sig verify: " + e.getMessage());
                    return;
                }
            }

            // 認證完成，接 OPEN
            AdbClient.Msg open;
            try {
                open = AdbClient.readMessage(in, version);
                expect(open.cmd == AdbClient.CMD_OPEN, "expect OPEN");
                checkCap(open, "client OPEN");
            } catch (RuntimeException e) {
                return;
            }
            int local = open.arg0;
            int remote = 7;
            String dest = new String(open.payload, 0,
                    Math.max(0, open.payload.length - 1), StandardCharsets.UTF_8);
            try {
                if (shell == Shell.ECHO_OK) {
                    expect(dest.equals("shell:echo ok"), "unexpected dest " + dest);
                    byte[] ok = "ok\n".getBytes(StandardCharsets.UTF_8);
                    AdbClient.writeMessage(out, AdbClient.CMD_OKAY, remote, local,
                            AdbClient.EMPTY);
                    AdbClient.writeMessage(out, AdbClient.CMD_WRTE, remote, local, ok);
                    AdbClient.writeMessage(out, AdbClient.CMD_CLSE, remote, local,
                            AdbClient.EMPTY);
                    AdbClient.Msg a1 = AdbClient.readMessage(in, version);
                    expect(a1.cmd == AdbClient.CMD_OKAY, "expect OKAY ack");
                    AdbClient.Msg a2 = AdbClient.readMessage(in, version);
                    expect(a2.cmd == AdbClient.CMD_CLSE, "expect CLSE reply");
                } else if (shell == Shell.BIG) {
                    AdbClient.writeMessage(out, AdbClient.CMD_OKAY, remote, local,
                            AdbClient.EMPTY);
                    int off = 0;
                    int n = 0;
                    while (off < bigOutput.length) {
                        int len = Math.min(2000, bigOutput.length - off);
                        byte[] chunk = Arrays.copyOfRange(bigOutput, off, off + len);
                        if (n == 1) {
                            // 其中一片故意 checksum 填 0（version>=1 視為合法）
                            ByteBuffer h = ByteBuffer.allocate(24)
                                    .order(ByteOrder.LITTLE_ENDIAN);
                            h.putInt(AdbClient.CMD_WRTE);
                            h.putInt(remote);
                            h.putInt(local);
                            h.putInt(chunk.length);
                            h.putInt(0);
                            h.putInt(AdbClient.CMD_WRTE ^ 0xffffffff);
                            out.write(h.array());
                            out.write(chunk);
                            out.flush();
                        } else {
                            AdbClient.writeMessage(out, AdbClient.CMD_WRTE, remote, local, chunk);
                        }
                        off += len;
                        n++;
                    }
                    AdbClient.writeMessage(out, AdbClient.CMD_CLSE, remote, local,
                            AdbClient.EMPTY);
                    for (int i = 0; i < n; i++) {
                        AdbClient.Msg a = AdbClient.readMessage(in, version);
                        expect(a.cmd == AdbClient.CMD_OKAY, "expect OKAY ack " + i);
                    }
                    AdbClient.Msg c = AdbClient.readMessage(in, version);
                    expect(c.cmd == AdbClient.CMD_CLSE, "expect CLSE reply");
                } else if (shell == Shell.TRUNCATED) {
                    AdbClient.writeMessage(out, AdbClient.CMD_OKAY, remote, local,
                            AdbClient.EMPTY);
                    ByteBuffer h = ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
                    h.putInt(AdbClient.CMD_WRTE);
                    h.putInt(remote);
                    h.putInt(local);
                    h.putInt(100); // 宣稱 100，實際只送 10 就斷線
                    h.putInt(0);
                    h.putInt(AdbClient.CMD_WRTE ^ 0xffffffff);
                    out.write(h.array());
                    out.write(new byte[10]);
                    out.flush();
                    s.close();
                }
            } catch (RuntimeException e) {
                return;
            }
        }
    }

    // ---------- 測試 ----------

    static void testVectors(String td) throws Exception {
        PrivateKey priv = AdbClient.loadPrivateKey(new File(td + "/adbkey"));
        RSAPrivateCrtKey crt = (RSAPrivateCrtKey) priv;
        PublicKey pub = KeyFactory.getInstance("RSA").generatePublic(
                new RSAPublicKeySpec(crt.getModulus(), crt.getPublicExponent()));
        String mine = AdbClient.adbPublicKeyString(pub).split(" ")[0];
        String theirs = new String(readFile(new File(td + "/adbkey.pub")),
                StandardCharsets.US_ASCII).split("\\s+")[0];
        check(mine.equals(theirs), "vector-pubkey",
                "pubkey base64 differs (len " + mine.length() + " vs " + theirs.length() + ")");
        byte[] token = readFile(new File(td + "/token.bin"));
        byte[] expectSig = readFile(new File(td + "/token.sig"));
        byte[] sig = AdbClient.signToken(priv, token);
        check(Arrays.equals(sig, expectSig), "vector-sig", "signature bytes differ");
        byte[] wire = (AdbClient.adbPublicKeyString(pub) + "\0").getBytes(StandardCharsets.UTF_8);
        check(wire[wire.length - 1] == 0, "vector-pubkey-nul", "wire pubkey must end with NUL");
        // 已存在的金鑰檔（只有私鑰 PKCS#8）：loadOrGenerateKey 推導出的公鑰必須與向量一致
        KeyPair fromFile = AdbClient.loadOrGenerateKey(new File(td + "/adbkey"));
        check(Arrays.equals(fromFile.getPublic().getEncoded(), pub.getEncoded()),
                "vector-loadOrGenerate-pubkey", "public key derived from key file differs");
    }

    static void testOpaquePrivateKey() throws Exception {
        // 模擬 Conscrypt：金鑰物件不實作 RSAPrivateCrtKey。
        // 舊程式碼在此直接 (RSAPrivateCrtKey) 轉型會丟 ClassCastException（實機 agent.log 的錯誤）。
        KeyPair kp = freshKey();
        final PrivateKey real = kp.getPrivate();
        final byte[] enc = real.getEncoded();
        PrivateKey opaque = new PrivateKey() {
            @Override
            public String getAlgorithm() {
                return "RSA";
            }

            @Override
            public String getFormat() {
                return "PKCS#8";
            }

            @Override
            public byte[] getEncoded() {
                return enc.clone();
            }
        };
        PublicKey derived = AdbClient.publicKeyFromPrivate(opaque);
        check(Arrays.equals(derived.getEncoded(), kp.getPublic().getEncoded()),
                "opaque-priv-pubkey", "public key derived from opaque private key differs");
        PublicKey direct = AdbClient.publicKeyFromPrivate(real);
        check(Arrays.equals(direct.getEncoded(), kp.getPublic().getEncoded()),
                "direct-priv-pubkey", "public key derived from provider key differs");
    }

    static void testConscryptBrokenObjectStillLoadsFromFile(String td) throws Exception {
        // 模擬實機 Conscrypt（電視 Android 11 agent.log）：
        // KeyFactory.getKeySpec(priv, RSAPrivateCrtKeySpec.class) 回傳不含 CRT 參數的
        // RSAPrivateKeySpec（舊程式碼隱式轉型即丟 ClassCastException），且金鑰物件的 getEncoded()
        // 不含可用的 publicExponent。正式路徑一律從檔案 DER 解析，不碰金鑰物件。
        final byte[] noExponent = new byte[] { 0x30, 0x03, 0x02, 0x01, 0x00 };
        PrivateKey broken = new PrivateKey() {
            @Override
            public String getAlgorithm() {
                return "RSA";
            }

            @Override
            public String getFormat() {
                return "PKCS#8";
            }

            @Override
            public byte[] getEncoded() {
                return noExponent.clone();
            }
        };
        boolean threw = false;
        String msg = "";
        try {
            AdbClient.publicKeyFromPrivate(broken);
        } catch (Exception e) {
            threw = true;
            msg = String.valueOf(e.getMessage());
        }
        check(threw, "conscrypt-broken-object-throws",
                "publicKeyFromPrivate should refuse key material without publicExponent");
        check(msg.contains("publicExponent") || msg.contains("PKCS#8"),
                "conscrypt-broken-error-specific",
                "error must name the step/field, got [" + msg + "]");
        // 關鍵斷言：同一個「壞物件」情境下，從 testdata/adbkey 檔載入仍與 adbkey.pub 逐 byte 相同
        KeyPair fromFile = AdbClient.loadOrGenerateKey(new File(td + "/adbkey"));
        String mine = AdbClient.adbPublicKeyString(fromFile.getPublic()).split(" ")[0];
        String theirs = new String(readFile(new File(td + "/adbkey.pub")),
                StandardCharsets.US_ASCII).split("\\s+")[0];
        check(mine.equals(theirs), "conscrypt-file-pubkey-matches-pub",
                "file-derived pubkey base64 differs (len " + mine.length()
                        + " vs " + theirs.length() + ")");
    }

    static void testGenerateThenLoadSameKey() throws Exception {
        // 產生與載入兩條路徑必須得到相同公鑰（寫系統暫存目錄，不污染 repo）
        File tmp = File.createTempFile("tvagent-conscrypt-test", ".pem");
        tmp.delete();
        try {
            KeyPair k1 = AdbClient.loadOrGenerateKey(tmp);
            check(tmp.exists(), "generate-writes-file", "key file was not created");
            KeyPair k2 = AdbClient.loadOrGenerateKey(tmp);
            check(Arrays.equals(k1.getPublic().getEncoded(), k2.getPublic().getEncoded()),
                    "generate-load-same-pubkey",
                    "public key differs between generate and reload");
        } finally {
            tmp.delete();
        }
    }

    static KeyPair freshKey() throws Exception {

        KeyPairGenerator g = KeyPairGenerator.getInstance("RSA");
        g.initialize(2048);
        return g.generateKeyPair();
    }

    static void testAuthRoundTrip() throws Exception {
        KeyPair kp = freshKey();
        // 第一輪：簽章被拒 → 送公鑰 → 通過
        Fake f1 = new Fake(Fake.Auth.REJECT_FIRST, Fake.Shell.ECHO_OK, 0x01000000, 2048);
        int p1 = f1.start();
        long t0 = System.currentTimeMillis();
        String out = runClient(p1, kp.getPrivate(), kp.getPublic(), "echo ok", 10000, 5000);
        long dt = System.currentTimeMillis() - t0;
        f1.awaitDone(8000);
        check(f1.failure == null, "round1-fake-clean",
                f1.failure == null ? "" : f1.failure);
        check(out.trim().equals("ok"), "round1-echo", "got [" + out.trim() + "]");
        check(f1.sawPubkey, "round1-sent-pubkey", "client never sent RSAPUBLICKEY");
        check(f1.capturedKey != null, "round1-key-parsed", "fake could not parse pubkey");
        check(dt < 15000, "round1-time", "took " + dt + " ms");

        // 第二輪：同一把金鑰簽章直接通過，不送公鑰
        Fake f2 = new Fake(Fake.Auth.ACCEPT_FIRST, Fake.Shell.ECHO_OK, 0x01000000, 4096);
        f2.knownKey = f1.capturedKey;
        int p2 = f2.start();
        String out2 = runClient(p2, kp.getPrivate(), kp.getPublic(), "echo ok", 10000, 5000);
        f2.awaitDone(8000);
        check(f2.failure == null, "round2-fake-clean",
                f2.failure == null ? "" : f2.failure);
        check(out2.trim().equals("ok"), "round2-echo", "got [" + out2.trim() + "]");
        check(!f2.sawPubkey, "round2-no-pubkey", "client sent RSAPUBLICKEY again");
    }

    static void testBigOutput() throws Exception {
        KeyPair kp = freshKey();
        byte[] big = new byte[10000];
        for (int i = 0; i < big.length; i++) {
            big[i] = (byte) (0x20 + (i % 95)); // 純 ASCII，UTF-8 往返無損
        }
        Fake f = new Fake(Fake.Auth.REJECT_FIRST, Fake.Shell.BIG, 0x01000001, 4096);
        f.bigOutput = big;
        int p = f.start();
        String out = runClient(p, kp.getPrivate(), kp.getPublic(), "echo big", 10000, 5000);
        f.awaitDone(8000);
        check(f.failure == null, "big-fake-clean", f.failure == null ? "" : f.failure);
        byte[] gotRaw = out.getBytes(StandardCharsets.UTF_8);
        check(Arrays.equals(gotRaw, big), "big-concat",
                "got " + gotRaw.length + " bytes, want " + big.length);
    }

    static void testTruncated() throws Exception {
        KeyPair kp = freshKey();
        Fake f = new Fake(Fake.Auth.REJECT_FIRST, Fake.Shell.TRUNCATED, 0x01000000, 4096);
        int p = f.start();
        long t0 = System.currentTimeMillis();
        boolean threw = false;
        try {
            runClient(p, kp.getPrivate(), kp.getPublic(), "echo x", 10000, 5000);
        } catch (AdbClient.AdbException e) {
            threw = true;
        }
        long dt = System.currentTimeMillis() - t0;
        f.awaitDone(8000);
        check(threw, "truncated-throws", "client did not report truncated packet");
        check(dt < 15000, "truncated-time", "took " + dt + " ms");
    }

    static void expectKind(String name, Fake.Auth auth, String wantKind,
            boolean kindOr, long authMs) throws Exception {
        KeyPair kp = freshKey();
        Fake f = new Fake(auth, Fake.Shell.NONE, 0x01000000, 4096);
        int p = f.start();
        long t0 = System.currentTimeMillis();
        String kind = null;
        try {
            runClient(p, kp.getPrivate(), kp.getPublic(), "echo ok", authMs, 1000);
        } catch (AdbClient.AdbException e) {
            kind = e.kind;
        }
        long dt = System.currentTimeMillis() - t0;
        f.awaitDone(8000);
        boolean kindOk = wantKind.equals(kind) || (kindOr && AdbClient.IO.equals(kind));
        check(kindOk, name + "-kind", "got kind " + kind + ", want " + wantKind
                + (kindOr ? " (or io)" : ""));
        check(dt < 15000, name + "-time", "took " + dt + " ms");
    }

    static void testErrors() throws Exception {
        // 連不上
        long t0 = System.currentTimeMillis();
        String kind = null;
        try {
            KeyPair kp = freshKey();
            runClient(freePort(), kp.getPrivate(), kp.getPublic(), "echo ok", 5000, 2000);
        } catch (AdbClient.AdbException e) {
            kind = e.kind;
        }
        long dt = System.currentTimeMillis() - t0;
        check(AdbClient.CONNECT.equals(kind), "err-connect-kind", "got " + kind);
        check(dt < 15000, "err-connect-time", "took " + dt + " ms");

        // 授權逾時（短逾時）：伺服器送完 CNXN 就沉默
        t0 = System.currentTimeMillis();
        KeyPair kp2 = freshKey();
        Fake fs = new Fake(Fake.Auth.SILENT, Fake.Shell.NONE, 0x01000000, 4096);
        int ps = fs.start();
        kind = null;
        try {
            runClient(ps, kp2.getPrivate(), kp2.getPublic(), "echo ok", 1500, 500);
        } catch (AdbClient.AdbException e) {
            kind = e.kind;
        }
        dt = System.currentTimeMillis() - t0;
        fs.awaitDone(12000);
        check(AdbClient.AUTH_TIMEOUT.equals(kind), "err-authtimeout-kind", "got " + kind);
        check(dt >= 1200 && dt < 15000, "err-authtimeout-time", "took " + dt + " ms");

        expectKind("err-disconnect", Fake.Auth.CLOSE_AFTER_TOKEN, AdbClient.AUTH_REJECTED, true,
                8000);
        expectKind("err-stls", Fake.Auth.STLS, AdbClient.TLS_REQUIRED, false, 8000);
        expectKind("err-badmagic", Fake.Auth.BAD_MAGIC, AdbClient.PROTOCOL, false, 8000);
        expectKind("err-badcksum", Fake.Auth.BAD_CHECKSUM, AdbClient.PROTOCOL, false, 8000);
        expectKind("err-garbage", Fake.Auth.GARBAGE_CMD, AdbClient.PROTOCOL, false, 8000);
    }

    public static void main(String[] args) {
        try {
            String td = args.length > 0 ? args[0] : "testdata";
            testVectors(td);
            testOpaquePrivateKey();
            testConscryptBrokenObjectStillLoadsFromFile(td);
            testGenerateThenLoadSameKey();
            testAuthRoundTrip();
            testBigOutput();
            testTruncated();
            testErrors();
            check("keep".equals(Whitelist.wlStatus(" keep\n")), "wl-keep", "keep");
            check("set".equals(Whitelist.wlStatus("set")), "wl-set", "set");
            check("fail".equals(Whitelist.wlStatus("fail")), "wl-fail", "fail");
            check("unexpected".equals(Whitelist.wlStatus("")), "wl-empty", "empty");
            check("unexpected".equals(Whitelist.wlStatus("亂碼")), "wl-garbage", "garbage");
            check("keep".equals(Whitelist.wlStatus("Failed to write while dumping service activity: Broken pipe\nkeep\n")), "wl-broken-pipe", "keep after error");
        } catch (Exception e) {
            System.out.println("FAIL harness :: " + e);
            e.printStackTrace(System.out);
            failures++;
        }
        if (failures == 0) {
            System.out.println("ALL PASS");
        } else {
            System.out.println(failures + " FAILURES");
            System.exit(1);
        }
    }
}

