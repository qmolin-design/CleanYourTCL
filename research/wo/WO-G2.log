## 讀紀錄

```sh
adb shell run-as com.example.tvagent cat files/agent.log
```

心跳行形狀：`<本地時間> uptime=<秒> pid=<pid> src=<alarm|start> adb=<ok|錯誤類別:訊息>`；
服務啟動記 `start reason=<boot|test|other>`。`adb=ok` 表示輸出 trim 後等於 `ok`。
pid 變化＝程序曾被系統砍掉重啟。

## TCL 凍結機制與鬧鐘心跳

實機發現：TCL 電視的 FreezeManager 會在 App 閒置十幾秒後把整個程序凍結，
前景服務也一樣；`ScheduledExecutorService` 的週期心跳因此停擺。
收到廣播時系統會立即解凍該程序，所以心跳改由 `AlarmManager` 驅動：

- 服務啟動（boot／test／other）與每次心跳後，都用
  `setExactAndAllowWhileIdle(ELAPSED_REALTIME_WAKEUP, now+60秒)` 排下一次
  精確鬧鐘（API 26～30 不需要 `SCHEDULE_EXACT_ALARM` 權限，故不新增權限；
  不用 `setRepeating`，每次觸發後重新排）。
- 鬧鐘送明確廣播給 `AlarmReceiver`（`exported=false`，無 intent-filter）。
- `AlarmReceiver` 收到後用 `startForegroundService` 送 action `HEARTBEAT` 給
  `AgentService`（服務若曾被殺也會因此重建）；服務把一次心跳排進原本的
  單執行緒 executor，並排下一次鬧鐘。executor 只留單次工作佇列，
  沒有 `scheduleAtFixedRate` 週期任務。
- `PendingIntent` 用固定 requestCode＋`FLAG_UPDATE_CURRENT`（另加
  `FLAG_IMMUTABLE`），同一時間只有一個待發鬧鐘。
- 心跳 `src=alarm` 表示鬧鐘觸發，`src=start` 表示服務啟動時先做的一次。
  心跳執行期間若被凍結，解凍時可能補跑：距上次心跳（`elapsedRealtime`）
  `< 30 秒` 就略過，同一分鐘內不重複寫兩次。

## 自我測試

```sh
adb shell am broadcast -n com.example.tvagent/.TestReceiver \
  -a com.example.tvagent.SELFTEST
```

服務在背景執行緒依序：停用 tkey → 查停用清單有 tkey → 啟用 tkey →
查停用清單無 tkey，最後寫 `selftest PASS`（或 `selftest FAIL <步驟>`）。
開始前若 tkey 已在停用清單，記 `selftest SKIP tkey-disabled` 不動作；
無論中途哪步失敗都會再嘗試 `pm enable` 恢復。

## 移除

```sh
adb uninstall com.example.tvagent
```

收尾只做 uninstall，不撤銷電視的 USB 偵錯授權（殘留公鑰對應的私鑰
已隨 App 刪除，無法再被使用）。
package com.example.tvagent;

import android.app.AlarmManager;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Context;
import android.content.Intent;
import android.os.Build;
import android.os.IBinder;
import android.os.Process;
import android.os.SystemClock;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/**
 * 前景服務：所有 adb 動作都在同一個單執行緒上序列化。
 * 心跳由 AlarmManager 精確鬧鐘驅動，每 60 秒一次（見 AlarmReceiver）：
 * 連本機 adbd 跑 echo ok，寫進 files/agent.log。
 * TCL 的 FreezeManager 會凍結閒置程序（含前景服務），
 * ScheduledExecutorService 的週期心跳因此停擺；改用鬧鐘＋廣播喚醒
 * （收到廣播時系統會解凍該程序）。executor 只留單次工作佇列。
 * SELFTEST 也排進同一條執行緒，不和心跳並行。
 *
 * 電視上可觸發的只有固定的心跳與 SELFTEST；沒有任何從 Intent extra
 * 或檔案讀入指令的路徑。
 */
public class AgentService extends Service {

    static final String EXTRA_REASON = "reason";
    static final String EXTRA_SELFTEST = "selftest";
    static final String SELFTEST_ACTION = "com.example.tvagent.SELFTEST";
    static final String HEARTBEAT_ACTION = "com.example.tvagent.HEARTBEAT";

    static final long HEARTBEAT_MS = 60 * 1000;
    static final long DEDUP_MS = 30 * 1000;
    static final int ALARM_REQ = 1;

    static final String TARGET = "com.example.tkey";
    static final String CMD_ECHO = "echo ok";
    static final String CMD_DISABLE = "pm disable-user --user 0 com.example.tkey";
    static final String CMD_LIST_DISABLED = "pm list packages -d";
    static final String CMD_ENABLE = "pm enable com.example.tkey";

    static final String HOST = "127.0.0.1";
    static final int PORT = 5555;
    static final long AUTH_TIMEOUT_MS = 60000;
    static final long IO_TIMEOUT_MS = 10000;

    private ExecutorService exec;
    private File logFile;
    private File keyFile;
    // 上次實際寫下心跳的 elapsedRealtime（毫秒）；凍結後補跑導致
    // 密集重複時，距上次 < DEDUP_MS 就略過，避免同一分鐘寫兩次。
    private volatile long lastHeartbeatElapsed = 0;

    @Override
    public void onCreate() {
        super.onCreate();
        startAsForeground();
        logFile = new File(getFilesDir(), "agent.log");
        keyFile = new File(getFilesDir(), "adbkey");
        // 單次工作佇列：心跳與 SELFTEST 都排進這裡序列化，不再做週期排程。
        exec = Executors.newSingleThreadExecutor();
    }

    /**
     * 排下一次鬧鐘（精確鬧鐘，每次觸發後由服務重新排下一次）。
     * PendingIntent 用固定 requestCode＋FLAG_UPDATE_CURRENT，
     * 同一時間只會有一個待發鬧鐘。API 26～30 用
     * setExactAndAllowWhileIdle，不需要 SCHEDULE_EXACT_ALARM 權限。
     */
    static void scheduleNextAlarm(Context ctx) {
        AlarmManager am = (AlarmManager) ctx.getSystemService(Context.ALARM_SERVICE);
        if (am == null) {
            return;
        }
        Intent i = new Intent(ctx, AlarmReceiver.class);
        int flags = PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE;
        PendingIntent pi = PendingIntent.getBroadcast(ctx, ALARM_REQ, i, flags);
        long next = SystemClock.elapsedRealtime() + HEARTBEAT_MS;
        am.setExactAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, next, pi);
    }

    private void startAsForeground() {
        String ch = "tvagent";
        if (Build.VERSION.SDK_INT >= 26) {
            NotificationChannel nc = new NotificationChannel(
                    ch, "tvagent 實驗", NotificationManager.IMPORTANCE_LOW);
            NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
            if (nm != null) {
                nm.createNotificationChannel(nc);
            }
        }
        Notification n;
        if (Build.VERSION.SDK_INT >= 26) {
            n = new Notification.Builder(this, ch)
                    .setContentTitle("tvagent 實驗")
                    .setContentText("adb 心跳執行中")
                    .setSmallIcon(android.R.drawable.stat_notify_sync)
                    .build();
        } else {
            n = new Notification.Builder(this)
                    .setContentTitle("tvagent 實驗")
                    .setContentText("adb 心跳執行中")
                    .setSmallIcon(android.R.drawable.stat_notify_sync)
                    .build();
        }
        startForeground(1, n);
    }

    @Override
    public int onStartCommand(final Intent intent, int flags, int startId) {
        // 立刻確保前景狀態（若系統重建服務時 intent 為 null 也要能撐住）。
        try {
            startAsForeground();
        } catch (Exception ignored) {
            // 已經是前景時重複呼叫無害
        }
        // 鬧鐘心跳：排一次心跳進單執行緒，並排下一次鬧鐘；
        // 服務若曾被殺，這裡的 startForegroundService 會把它重建。
        if (intent != null && HEARTBEAT_ACTION.equals(intent.getAction())) {
            if (exec != null) {
                exec.execute(new Runnable() {
                    @Override
                    public void run() {
                        heartbeat("alarm");
                    }
                });
            }
            scheduleNextAlarm(this);
            return START_STICKY;
        }
        String reason = "other";
        boolean wantSelftest = false;
        if (intent != null) {
            String r = intent.getStringExtra(EXTRA_REASON);
            if ("boot".equals(r) || "test".equals(r)) {
                reason = r;
            }
            wantSelftest = intent.getBooleanExtra(EXTRA_SELFTEST, false);
        }
        final String logReason = reason;
        // start 行由主執行緒直接寫，避免和背景工作搶順序造成混淆。
        logLine("start reason=" + logReason);
        // 服務啟動（boot／test／other，含系統重建時的 null intent）
        // 都要確保下一次鬧鐘已排好，並先做一次心跳（src=start）。
        scheduleNextAlarm(this);
        if (exec != null) {
            exec.execute(new Runnable() {
                @Override
                public void run() {
                    heartbeat("start");
                }
            });
            if (wantSelftest) {
                exec.execute(new Runnable() {
                    @Override
                    public void run() {
                        runSelftest();
                    }
                });
            }
        }
        return START_STICKY;
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    @Override
    public void onDestroy() {
        if (exec != null) {
            exec.shutdownNow();
            exec = null;
        }
        super.onDestroy();
    }

    private String runAdb(String cmd) throws AdbClient.AdbException {
        try {
            AdbClient c = AdbClient.withKeyFile(HOST, PORT, keyFile);
            c.setAuthTimeoutMs(AUTH_TIMEOUT_MS);
            c.setIoTimeoutMs(IO_TIMEOUT_MS);
            return c.shell(cmd);
        } catch (AdbClient.AdbException e) {
            throw e;
        } catch (Exception e) {
            throw new AdbClient.AdbException(AdbClient.IO, "key error: " + e.getMessage());
        }
    }

    private void heartbeat(String src) {
        // 凍結期間被略過的心跳可能在解凍時補跑：距上次 < 30 秒就略過，
        // 同一分鐘內不重複寫兩次。心跳都在單執行緒上跑，不會有並行問題。
        long now = SystemClock.elapsedRealtime();
        if (now - lastHeartbeatElapsed < DEDUP_MS) {
            return;
        }
        lastHeartbeatElapsed = now;
        String status;
        try {
            String output = runAdb(CMD_ECHO);
            status = output.trim().equals("ok") ? "ok" : "io:unexpected-output";
        } catch (AdbClient.AdbException e) {
            status = e.kind + ":" + oneLine(e.getMessage());
        } catch (Exception e) {
            status = AdbClient.IO + ":" + oneLine(e.getMessage());
        }
        long uptime = SystemClock.elapsedRealtime() / 1000;
        logLine("uptime=" + uptime + " pid=" + Process.myPid() + " src=" + src + " adb=" + status);
    }

    private void runSelftest() {
        // 0. 先確認有授權（必要時等授權）；沒有就結束。
        try {
            String echo = runAdb(CMD_ECHO);
            if (!echo.trim().equals("ok")) {
                logLine("selftest FAIL auth");
                return;
            }
        } catch (AdbClient.AdbException e) {
            logLine("selftest FAIL auth");
            return;
        }
        // 開始前檢查：tkey 已停用就不動。
        try {
            if (runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                logLine("selftest SKIP tkey-disabled");
                return;
            }
        } catch (AdbClient.AdbException e) {
            logLine("selftest FAIL 0");
            tryEnable();
            return;
        }
        int fail = -1;
        // 1. 停用
        try {
            runAdb(CMD_DISABLE);
        } catch (AdbClient.AdbException e) {
            fail = 1;
        }
        // 2. 確認出現在停用清單
        if (fail < 0) {
            try {
                if (!runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                    fail = 2;
                }
            } catch (AdbClient.AdbException e) {
                fail = 2;
            }
        }
        // 3. 啟用
        if (fail < 0) {
            try {
                runAdb(CMD_ENABLE);
            } catch (AdbClient.AdbException e) {
                fail = 3;
            }
        }
        // 4. 確認已不在停用清單
        if (fail < 0) {
            try {
                if (runAdb(CMD_LIST_DISABLED).contains(TARGET)) {
                    fail = 4;
                }
            } catch (AdbClient.AdbException e) {
                fail = 4;
            }
        }
        // 無論成敗都要嘗試恢復啟用。
        tryEnable();
        if (fail < 0) {
            logLine("selftest PASS");
        } else {
            logLine("selftest FAIL " + fail);
        }
    }

    private void tryEnable() {
        try {
            runAdb(CMD_ENABLE);
        } catch (Exception ignored) {
            // 恢復盡力而為
        }
    }

    private static String oneLine(String s) {
        if (s == null) {
            return "";
        }
        return s.replace('\n', ' ').replace('\r', ' ').trim();
    }

    synchronized void logLine(String msg) {
        String ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault())
                .format(new Date());
        FileWriter w = null;
        try {
            w = new FileWriter(logFile, true);
            w.write(ts + " " + msg + "\n");
        } catch (IOException ignored) {
            // 寫 log 失敗不影響主流程
        } finally {
            if (w != null) {
                try {
                    w.close();
                } catch (IOException ignored) {
                    // 忽略
                }
            }
        }
    }
}

