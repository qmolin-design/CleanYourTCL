   125	        Quota.Usage usage = new Quota.Usage(0, 0, 0, q.ytFg, q.fgPkg, q.scrOn);
   126	        if (q.qWall > 0 && wall >= q.qWall) {
   127	            UsageStatsManager manager = (UsageStatsManager) getSystemService(USAGE_STATS_SERVICE);
   128	            List<Quota.Ev> events = new ArrayList<>(); UsageEvents results = manager.queryEvents(q.qWall, wall); UsageEvents.Event event = new UsageEvents.Event();
   129	            while (results.hasNextEvent()) { results.getNextEvent(event); events.add(new Quota.Ev(event.getTimeStamp(), event.getEventType(), event.getPackageName())); }
   130	            usage = Quota.usage(events, q.qWall, wall, q.ytFg, q.fgPkg, q.scrOn, freeToWall);
   131	        }
   132	        Status s = status();
   133	        long seconds = jump ? (Boolean.TRUE.equals(s.fg) && s.screen.equals("on") ? Math.max(0, (el - Math.max(q.qEl, q.adultEnd)) / 1000) : 0) : usage.seconds;
   134	        long ytS = usage.ytS, nfS = usage.nfS;
   135	        if (jump) { ytS = 0; nfS = 0; if (seconds > 0) { if (Quota.YT.equals(s.fgPkg)) ytS = seconds; else if (Quota.NF.equals(s.fgPkg)) nfS = seconds; } }
   136	        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd", Locale.US); format.setTimeZone(TimeZone.getTimeZone("Asia/Taipei"));
   137	        String today = format.format(new Date(wall));
   138	        q.consume(seconds, today); q.usedTodayYt += ytS; q.usedTodayNf += nfS;
   139	        q.qWall = wall; q.qEl = el; q.bootCount = boot; q.ytFg = usage.ytFg; q.fgPkg = usage.fgPkg; q.scrOn = usage.scrOn;
   140	        if (!s.yt.equals("unknown")) { q.ytFg = Boolean.TRUE.equals(s.fg); q.fgPkg = s.fgPkg == null ? "" : s.fgPkg; q.scrOn = s.screen.equals("on"); }
   141	        String action = act(q, s), sync = "skip";
   142	        try {
   143	            save(q);
   144	            long balBefore = q.balance;
   145	            boolean enforceBefore = q.enforce;
   146	            long effBefore = q.balance + q.adultLeft(el);
   147	            sync = sync(q, s, gap, boot, el, today);
   148	            if (sync.equals("ok")) {
   149	                long elAfter = SystemClock.elapsedRealtime();
   150	                long effAfter = q.balance + q.adultLeft(elAfter);
   151	                if (q.balance != balBefore || q.enforce != enforceBefore
   152	                        || (effBefore > 0) != (effAfter > 0) || (effBefore <= 300) != (effAfter <= 300)) action += "," + act(q, s);
   153	                save(q);
   154	            }
   155	        }
   156	        catch (Exception ex) { sync = "io"; }
   157	        long adultSec = q.adultLeft(SystemClock.elapsedRealtime());
   158	        scheduleNextAlarm(this, q.nextAlarmMs(Boolean.TRUE.equals(s.fg) && s.screen.equals("on"), adultSec));
   159	        log("uptime=" + el / 1000 + " pid=" + android.os.Process.myPid() + " src=" + src + " bal=" + q.balance + " adult=" + adultSec + " used_today=" + q.usedToday + " yt_s=" + q.usedTodayYt + " nf_s=" + q.usedTodayNf + " fg=" + s.fg + " yt=" + s.yt + " screen=" + s.screen + " act=" + action + " sync=" + sync + " adb=" + s.adb + " wl=" + s.wl + " setup=" + setupResult + (gap > 300 ? " gap=" + gap : "") + (jump ? " clock=jump" : ""));
   160	    }
   161	    private String sync(Quota q, Status s, long gap, long boot, long el, String today) throws Exception {
   162	        Properties config = new Properties();
   163	        try (FileInputStream in = new FileInputStream(new File(getFilesDir(), "config.properties"))) { config.load(in); }
   164	        catch (FileNotFoundException e) { return "skip"; }
   165	        String url = config.getProperty("url"), id = config.getProperty("client_id"), secret = config.getProperty("client_secret");
   166	        if (url == null || id == null || secret == null || id.isEmpty() || secret.isEmpty()) return "config";
   167	        JSONObject request = new JSONObject();
   168	        request.put("v", 1); request.put("last_seq", q.lastSeq < 0 ? JSONObject.NULL : q.lastSeq); request.put("db_id", q.dbId == null ? JSONObject.NULL : q.dbId);
   169	        request.put("balance_s", q.balance); request.put("capped", q.capped); request.put("used_today_s", q.usedToday); request.put("used_total_s", q.usedTotal);
   170	        request.put("today", today); request.put("used_today_yt_s", q.usedTodayYt); request.put("used_today_nf_s", q.usedTodayNf);
   171	        request.put("yt", s.yt); request.put("fg_yt", s.fg == null ? JSONObject.NULL : s.fg); request.put("screen", s.screen); request.put("adb", s.adb); request.put("enforce", q.enforce);
   172	        request.put("boot_count", boot); request.put("uptime_s", el / 1000); request.put("gap_s", gap); request.put("wl", s.wl); request.put("app_ver", 4);
   173	        HttpsURLConnection c = (HttpsURLConnection) new URL(url).openConnection();
   174	        try {
   175	            c.setConnectTimeout(10000); c.setReadTimeout(10000); c.setRequestMethod("POST"); c.setDoOutput(true); c.setRequestProperty("Content-Type", "application/json"); c.setRequestProperty("CF-Access-Client-Id", id); c.setRequestProperty("CF-Access-Client-Secret", secret);
   176	            try (OutputStream out = c.getOutputStream()) { out.write(request.toString().getBytes("UTF-8")); }
   177	            int code = c.getResponseCode(); if (code != 200) return "http:" + code;
   178	            ByteArrayOutputStream bytes = new ByteArrayOutputStream(); try (InputStream in = c.getInputStream()) { byte[] buf = new byte[4096]; int n; while ((n = in.read(buf)) != -1) { bytes.write(buf, 0, n); if (bytes.size() > 1048576) throw new IOException("response too large"); } }
   179	            JSONObject data = new JSONObject(bytes.toString("UTF-8")); JSONArray array = data.getJSONArray("grants"); List<Quota.Grant> grants = new ArrayList<>();
   180	            long max = data.getLong("max_seq"), cap = data.getLong("cap_s"); String db = data.getString("db_id"); boolean enforce = data.getBoolean("enforce");
   181	            if (max < 0 || cap < 0 || db.isEmpty()) throw new IOException("response");
   182	            for (int i = 0; i < array.length(); i++) { JSONObject g = array.getJSONObject(i); long seq = g.getLong("seq"), seconds = g.getLong("seconds"); String kind = g.getString("kind"); if (seq < 0 || seq > max || seconds < 0 || seconds > 86400 || (!kind.equals("add") && !kind.equals("set"))) throw new IOException("grant"); grants.add(new Quota.Grant(seq, kind, seconds)); }
   183	            q.applySync(grants, max, db, cap, enforce);
   184	            long adultLeftS;
   185	            try { adultLeftS = data.optLong("adult_left_s", 0); } catch (RuntimeException ex) { adultLeftS = 0; }
   186	            if (adultLeftS < 0 || adultLeftS > 86400) adultLeftS = 0; // 舊 Worker 沒這欄＝0；錯值不讓整次 sync 失敗
   187	            long el2 = SystemClock.elapsedRealtime(); // 解析完回應後重取（WO-A2 裁定 #11）
   188	            q.adultEnd = adultLeftS > 0 ? el2 + Math.min(adultLeftS, 600) * 1000 : 0; // 每次成功 sync 都覆寫；0→清零（fix1：否則下一跳排除掉 status＋act＋sync 耗時對應的前景）；>0 最多續 10 分鐘
   189	            return "ok";
   190	        } finally { c.disconnect(); }
   191	    }
   192	    private void log(String line) {
   193	        try {
   194	            SimpleDateFormat ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US);
   195	            ts.setTimeZone(TimeZone.getTimeZone("Asia/Taipei"));
   196	            line = ts.format(new Date()) + " " + line;
   197	            if (logFile.length() > 1048576) {
   198	                try (RandomAccessFile file = new RandomAccessFile(logFile, "rw")) { long start = file.length() - 524288; file.seek(start); file.readLine(); start = file.getFilePointer(); byte[] tail = new byte[(int)(file.length() - start)]; file.readFully(tail); file.seek(0); file.write(tail); file.setLength(tail.length); }
   199	            }
   200	            try (FileWriter out = new FileWriter(logFile, true)) { out.write(line + "\n"); }
   201	        } catch (IOException ignored) { }
   202	    }
   203	}

