    70	    private static final class Status { String yt = "unknown", screen = "unknown", adb = "ok", wl = "skip", fgPkg; Boolean fg; boolean mixed; }
    71	    private Status status() {
    72	        Status s = new Status();
    73	        try {
    74	            if (!configured) {
    75	                String setup = adb("for c in 'cmd appops set com.example.tvagent APP_AUTO_START allow' 'cmd appops set com.example.tvagent APP_ASSOC_START allow' 'cmd appops set com.example.tvagent GET_USAGE_STATS allow' 'am set-standby-bucket com.example.tvagent active' 'dumpsys deviceidle whitelist +com.example.tvagent'; do sh -c \"$c\" >/dev/null 2>&1 && printf 1 || printf 0; done; echo");
    76	                configured = setup.trim().equals("11111");
    77	                // Setup result is included in the heartbeat log without command output.
    78	                setupResult = setup.trim().matches("[01]{5}") ? setup.trim() : "failed";
    79	            }
    80	            String out = adb("echo __POWER__; dumpsys power || echo __FAIL__; echo __DISABLED__; pm list packages -d || echo __FAIL__; echo __ACTIVITY__; if [ \"$(pm list packages -d | grep -cx -e package:com.google.android.youtube.tv -e package:com.netflix.ninja)\" = 2 ]; then echo __SKIP__; else dumpsys activity activities || echo __FAIL__; fi; echo __END__");
    81	            int p = out.indexOf("__POWER__"), d = out.indexOf("__DISABLED__"), a = out.indexOf("__ACTIVITY__"), e = out.indexOf("__END__");
    82	            if (out.contains("__FAIL__") || p < 0 || d <= p || a <= d || e <= a) throw new AdbClient.AdbException(AdbClient.IO, "status");
    83	            String power = out.substring(p, d), disabled = out.substring(d, a), activity = out.substring(a, e);
    84	            if (!power.contains("mWakefulness=")) throw new AdbClient.AdbException(AdbClient.IO, "power");
    85	            s.screen = power.contains("mWakefulness=Awake") ? "on" : "off";
    86	            List<String> off = Arrays.asList(disabled.split("\\r?\\n"));
    87	            boolean ytOff = off.contains("package:" + Quota.YT), nfOff = off.contains("package:" + Quota.NF);
    88	            s.yt = ytOff && nfOff ? "disabled" : "enabled"; s.mixed = ytOff != nfOff;
    89	            if (!(ytOff && nfOff)) { if (!activity.contains("mResumedActivity")) throw new AdbClient.AdbException(AdbClient.IO, "activity"); s.fg = false; s.fgPkg = null; for (String line : activity.split("\\r?\\n")) if (line.contains("mResumedActivity") && (line.contains(Quota.YT) || line.contains(Quota.NF))) { s.fg = true; s.fgPkg = line.contains(Quota.YT) ? Quota.YT : Quota.NF; } }
    90	            s.wl = Whitelist.wlStatus(adb(CMD_WHITELIST));
    91	        } catch (AdbClient.AdbException ex) { s.adb = ex.kind; s.yt = "unknown"; s.screen = "unknown"; s.fg = null; s.mixed = false; }
    92	        return s;
    93	    }
    94	    private String setupResult = "pending";
    95	    private String act(Quota q, Status s) {
    96	        Quota.Action action = q.decide(s.yt, s.mixed, Boolean.TRUE.equals(s.fg), s.screen.equals("on"));
    97	        String name = action.name().toLowerCase(Locale.US);
    98	        if (action == Quota.Action.NONE) return name;
    99	        if (!q.enforce) return "dry-" + name;
   100	        try {
   101	            if (action == Quota.Action.WARN || action == Quota.Action.END) adb("am start -n com.example.tvagent/.NoticeActivity --es kind " + (action == Quota.Action.WARN ? "warn" : "end"));
   102	            if (action == Quota.Action.END) Thread.sleep(10000);
   103	            if (action == Quota.Action.END || action == Quota.Action.LOCK) {
   104	                adb("am force-stop " + Quota.YT + "; am force-stop " + Quota.NF + "; " + DISABLE);
   105	                List<String> off = Arrays.asList(adb(LIST).split("\\r?\\n"));
   106	                if (!off.contains("package:" + Quota.YT) || !off.contains("package:" + Quota.NF)) throw new AdbClient.AdbException(AdbClient.IO, "verify");
   107	                s.yt = "disabled"; s.fg = null; s.mixed = false; q.ytFg = false; q.fgPkg = "";
   108	            } else if (action == Quota.Action.UNLOCK) {
   109	                adb(ENABLE);
   110	                List<String> off = Arrays.asList(adb(LIST).split("\\r?\\n"));
   111	                if (off.contains("package:" + Quota.YT) || off.contains("package:" + Quota.NF)) throw new AdbClient.AdbException(AdbClient.IO, "verify");
   112	                s.yt = "enabled"; if (!s.mixed) s.fg = false; s.mixed = false; // mixed 時保持探測到的前景值
   113	            }
   114	        } catch (AdbClient.AdbException ex) { s.adb = ex.kind; s.yt = "unknown"; s.fg = null; s.mixed = false; }
   115	        catch (InterruptedException ex) { Thread.currentThread().interrupt(); s.adb = "io"; s.yt = "unknown"; s.fg = null; s.mixed = false; }
   116	        return name;
   117	    }
   118	    private void heartbeat(String src) {
   119	        Quota q = load(); long wall = System.currentTimeMillis(), el = SystemClock.elapsedRealtime();
   120	        long boot = Settings.Global.getInt(getContentResolver(), Settings.Global.BOOT_COUNT, -1);
   121	        long gap = q.qEl > 0 && q.bootCount == boot ? Math.max(0, (el - q.qEl) / 1000) : 0;
   122	        boolean jump = q.qWall > 0 && Quota.clockJump(q.qWall, wall, q.qEl, el, q.bootCount, boot);
   123	        Quota.Usage usage = new Quota.Usage(0, 0, 0, q.ytFg, q.fgPkg, q.scrOn);
   124	        if (q.qWall > 0 && wall >= q.qWall) {
   125	            UsageStatsManager manager = (UsageStatsManager) getSystemService(USAGE_STATS_SERVICE);
   126	            List<Quota.Ev> events = new ArrayList<>(); UsageEvents results = manager.queryEvents(q.qWall, wall); UsageEvents.Event event = new UsageEvents.Event();
   127	            while (results.hasNextEvent()) { results.getNextEvent(event); events.add(new Quota.Ev(event.getTimeStamp(), event.getEventType(), event.getPackageName())); }
   128	            usage = Quota.usage(events, q.qWall, wall, q.ytFg, q.fgPkg, q.scrOn);
   129	        }
   130	        Status s = status();
   131	        long seconds = jump ? (Boolean.TRUE.equals(s.fg) && s.screen.equals("on") ? Math.max(0, (el - q.qEl) / 1000) : 0) : usage.seconds;
   132	        long ytS = usage.ytS, nfS = usage.nfS;
   133	        if (jump) { ytS = 0; nfS = 0; if (seconds > 0) { if (Quota.YT.equals(s.fgPkg)) ytS = seconds; else if (Quota.NF.equals(s.fgPkg)) nfS = seconds; } }
   134	        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd", Locale.US); format.setTimeZone(TimeZone.getTimeZone("Asia/Taipei"));
   135	        String today = format.format(new Date(wall));
   136	        q.consume(seconds, today); q.usedTodayYt += ytS; q.usedTodayNf += nfS;
   137	        q.qWall = wall; q.qEl = el; q.bootCount = boot; q.ytFg = usage.ytFg; q.fgPkg = usage.fgPkg; q.scrOn = usage.scrOn;
   138	        if (!s.yt.equals("unknown")) { q.ytFg = Boolean.TRUE.equals(s.fg); q.fgPkg = s.fgPkg == null ? "" : s.fgPkg; q.scrOn = s.screen.equals("on"); }
   139	        String action = act(q, s), sync = "skip";
   140	        try {
   141	            save(q);
   142	            long balBefore = q.balance;
   143	            boolean enforceBefore = q.enforce;
   144	            sync = sync(q, s, gap, boot, el, today);
   145	            if (sync.equals("ok")) { if (q.balance != balBefore || q.enforce != enforceBefore) action += "," + act(q, s); save(q); }
   146	        }
   147	        catch (Exception ex) { sync = "io"; }
   148	        scheduleNextAlarm(this, q.nextAlarmMs(Boolean.TRUE.equals(s.fg) && s.screen.equals("on")));
   149	        log("uptime=" + el / 1000 + " pid=" + android.os.Process.myPid() + " src=" + src + " bal=" + q.balance + " used_today=" + q.usedToday + " yt_s=" + q.usedTodayYt + " nf_s=" + q.usedTodayNf + " fg=" + s.fg + " yt=" + s.yt + " screen=" + s.screen + " act=" + action + " sync=" + sync + " adb=" + s.adb + " wl=" + s.wl + " setup=" + setupResult + (gap > 300 ? " gap=" + gap : "") + (jump ? " clock=jump" : ""));
   150	    }
   151	    private String sync(Quota q, Status s, long gap, long boot, long el, String today) throws Exception {
   152	        Properties config = new Properties();
   153	        try (FileInputStream in = new FileInputStream(new File(getFilesDir(), "config.properties"))) { config.load(in); }
   154	        catch (FileNotFoundException e) { return "skip"; }
   155	        String url = config.getProperty("url"), id = config.getProperty("client_id"), secret = config.getProperty("client_secret");
   156	        if (url == null || id == null || secret == null || id.isEmpty() || secret.isEmpty()) return "config";
   157	        JSONObject request = new JSONObject();
   158	        request.put("v", 1); request.put("last_seq", q.lastSeq < 0 ? JSONObject.NULL : q.lastSeq); request.put("db_id", q.dbId == null ? JSONObject.NULL : q.dbId);
   159	        request.put("balance_s", q.balance); request.put("capped", q.capped); request.put("used_today_s", q.usedToday); request.put("used_total_s", q.usedTotal);
   160	        request.put("today", today); request.put("used_today_yt_s", q.usedTodayYt); request.put("used_today_nf_s", q.usedTodayNf);
   161	        request.put("yt", s.yt); request.put("fg_yt", s.fg == null ? JSONObject.NULL : s.fg); request.put("screen", s.screen); request.put("adb", s.adb); request.put("enforce", q.enforce);
   162	        request.put("boot_count", boot); request.put("uptime_s", el / 1000); request.put("gap_s", gap); request.put("wl", s.wl); request.put("app_ver", 3);
   163	        HttpsURLConnection c = (HttpsURLConnection) new URL(url).openConnection();
   164	        try {
   165	            c.setConnectTimeout(10000); c.setReadTimeout(10000); c.setRequestMethod("POST"); c.setDoOutput(true); c.setRequestProperty("Content-Type", "application/json"); c.setRequestProperty("CF-Access-Client-Id", id); c.setRequestProperty("CF-Access-Client-Secret", secret);
   166	            try (OutputStream out = c.getOutputStream()) { out.write(request.toString().getBytes("UTF-8")); }
   167	            int code = c.getResponseCode(); if (code != 200) return "http:" + code;
   168	            ByteArrayOutputStream bytes = new ByteArrayOutputStream(); try (InputStream in = c.getInputStream()) { byte[] buf = new byte[4096]; int n; while ((n = in.read(buf)) != -1) { bytes.write(buf, 0, n); if (bytes.size() > 1048576) throw new IOException("response too large"); } }
   169	            JSONObject data = new JSONObject(bytes.toString("UTF-8")); JSONArray array = data.getJSONArray("grants"); List<Quota.Grant> grants = new ArrayList<>();
   170	            long max = data.getLong("max_seq"), cap = data.getLong("cap_s"); String db = data.getString("db_id"); boolean enforce = data.getBoolean("enforce");
   171	            if (max < 0 || cap < 0 || db.isEmpty()) throw new IOException("response");
   172	            for (int i = 0; i < array.length(); i++) { JSONObject g = array.getJSONObject(i); long seq = g.getLong("seq"), seconds = g.getLong("seconds"); String kind = g.getString("kind"); if (seq < 0 || seq > max || seconds < 0 || seconds > 86400 || (!kind.equals("add") && !kind.equals("set"))) throw new IOException("grant"); grants.add(new Quota.Grant(seq, kind, seconds)); }
   173	            q.applySync(grants, max, db, cap, enforce); return "ok";
   174	        } finally { c.disconnect(); }
   175	    }
   176	    private void log(String line) {
   177	        try {
   178	            SimpleDateFormat ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US);
   179	            ts.setTimeZone(TimeZone.getTimeZone("Asia/Taipei"));
   180	            line = ts.format(new Date()) + " " + line;
   181	            if (logFile.length() > 1048576) {
   182	                try (RandomAccessFile file = new RandomAccessFile(logFile, "rw")) { long start = file.length() - 524288; file.seek(start); file.readLine(); start = file.getFilePointer(); byte[] tail = new byte[(int)(file.length() - start)]; file.readFully(tail); file.seek(0); file.write(tail); file.setLength(tail.length); }
   183	            }
   184	            try (FileWriter out = new FileWriter(logFile, true)) { out.write(line + "\n"); }
   185	        } catch (IOException ignored) { }
   186	    }
