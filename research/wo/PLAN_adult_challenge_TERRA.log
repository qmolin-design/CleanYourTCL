    47	        String reason = intent != null ? intent.getStringExtra(EXTRA_REASON) : null;
    48	        if (!"boot".equals(reason) && !"kick".equals(reason)) reason = "alarm";
    49	        final String src = reason;
    50	        scheduleNextAlarm(this, 60000);
    51	        exec.execute(new Runnable() { public void run() { heartbeat(src); } });
    52	        return START_STICKY;
    53	    }
