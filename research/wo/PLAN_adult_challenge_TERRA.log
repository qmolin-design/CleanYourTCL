    35	    static void scheduleNextAlarm(Context context, long delay) {
    36	        AlarmManager am = (AlarmManager) context.getSystemService(ALARM_SERVICE);
    37	        if (am != null) am.setExactAndAllowWhileIdle(AlarmManager.ELAPSED_REALTIME_WAKEUP, SystemClock.elapsedRealtime() + delay,
    38	                PendingIntent.getBroadcast(context, 1, new Intent(context, AlarmReceiver.class), PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));
    39	    }
    40	    private void startAsForeground() {
