   172	export async function handle(req, env, now) {
   173	  const path = new URL(req.url).pathname;
   174	  if (!path.startsWith('/tv/')) return error(404);
   175	  const user = await identity(req, env, now);
   176	  if (!user) return error(401);
   177	  if (req.method === 'POST' && path === '/tv/api/grant' && req.headers.get('Origin') !== 'https://tv-demo.example.net') return error(403);
   178	  const role = path === '/tv/api/sync' ? 'tv' : 'parent';
   179	  if (user.role !== role) return error(403);
   180	  if (req.method === 'GET' && path === '/tv/') return new Response(page, { headers: { 'Content-Type':'text/html; charset=utf-8', 'Cache-Control':'no-store' } });
   181	  const offline = Number(env.OFFLINE_MIN) > 0 ? Number(env.OFFLINE_MIN) : 30, seconds = Math.floor(now / 1000);
   182	  if (req.method === 'GET' && path === '/tv/api/state') return response(await state(env.DB, user.name, seconds, offline));
   183	  if (req.method === 'POST' && (path === '/tv/api/sync' || path === '/tv/api/grant')) {
   184	    let body; try { body = await req.json(); } catch { return error(400); }
   185	    if (path === '/tv/api/sync') return validReport(body) ? response(await sync(env.DB, body, seconds, offline)) : error(400);
   186	    const result = await grant(env.DB, body, user.name, seconds);
   187	    return result ? response(result) : error(400);
   188	  }
   189	  return error(404);
   190	}

