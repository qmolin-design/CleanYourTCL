    42	        if (nm != null) nm.createNotificationChannel(new NotificationChannel("tvagent", "看電視時間", NotificationManager.IMPORTANCE_LOW));
    43	        startForeground(1, new Notification.Builder(this, "tvagent").setContentTitle("看電視時間").setContentText("額度服務執行中").setSmallIcon(android.R.drawable.stat_notify_sync).build());
    44	    }
    45	    @Override public int onStartCommand(Intent intent, int flags, int startId) {
