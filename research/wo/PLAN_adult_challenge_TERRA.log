    63	    static Usage usage(List<Ev> events, long from, long to, boolean fg, String fgPkg, boolean screen) {
    64	        List<Ev> sorted = new ArrayList<>(events); Collections.sort(sorted, new Comparator<Ev>() { public int compare(Ev a, Ev b) { return Long.compare(a.wallMs, b.wallMs); } });
    65	        long cursor = from, total = 0, yt = 0, nf = 0;
    66	        String pkg = fgPkg == null ? "" : fgPkg;
    67	        for (Ev e : sorted) {
    68	            if (e.wallMs < from || e.wallMs > to) continue;
    69	            if (fg && screen) { long d = e.wallMs - cursor; total += d; if (YT.equals(pkg)) yt += d; else if (NF.equals(pkg)) nf += d; }
    70	            cursor = e.wallMs;
    71	            switch (e.type) {
    72	                case 1: if (ctl(e.pkg)) { fg = true; pkg = e.pkg; } else { fg = false; pkg = ""; } break;
    73	                case 2: if (ctl(e.pkg)) { fg = false; pkg = ""; } break; // STOPPED(23) 會晚於新 App 的 RESUMED，不處理
    74	                case 15: screen = true; break;
    75	                case 16: screen = false; break;
    76	                case 26: fg = false; screen = false; pkg = ""; break;
    77	                case 27: fg = false; screen = true; pkg = ""; break;
    78	            }
    79	        }
    80	        if (fg && screen && to > cursor) { long d = to - cursor; total += d; if (YT.equals(pkg)) yt += d; else if (NF.equals(pkg)) nf += d; }
    81	        return new Usage(total / 1000, yt / 1000, nf / 1000, fg, pkg, screen);
    82	    }
    83	    static boolean clockJump(long oldWall, long wall, long oldEl, long el, long oldBoot, long boot) {
    84	        return oldBoot >= 0 && oldBoot == boot && Math.abs((wall - oldWall) - (el - oldEl)) > 60000;
