#"'!/usr/bin/env python3
import datetime
import hmac
import json
import os
import signal
import subprocess
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

HOME = Path(os.environ.get('"'TVGATE_HOME', Path.home() / 'Library/Application Support/tvgate'))
TOKEN = [REDACTED_SECRET]'TVGATE_TOKEN', Path.home() / '.secrets/tvgate.token'))
ADB = os.environ.get('ADB', 'adb')
HOOK = os.environ.get('TVGATE_HOOK', str(Path(__file__).with_name('sleephook')))
NOTIFY = os.environ.get('TVGATE_NOTIFY', 'osascript')
INTERVAL = float(os.environ.get('TVGATE_INTERVAL', '30'))
DEVICE = '192.0.2.69:5555'
PACKAGE = 'com.google.android.youtube.tv'
STATE = HOME / 'state.json'
LOG = Path.home() / 'Library/Logs/tvgate.log'
state_lock = threading.RLock()
adb_lock = threading.Lock()
stop = threading.Event()
until = None
tv = 'unknown'
checked_at = None
grace = False
failed_since = None
last_apply = 0
hook = None


def log(action, result):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open('a') as f:
            f.write(f'{datetime.datetime.now().isoformat(timespec=\"seconds\")} {action} {result}\\n')
    except OSError:
        pass


def authorized():
    return until is not None and until > time.time()


def display(timestamp, fmt='%H:%M'):
    return datetime.datetime.fromtimestamp(timestamp).strftime(fmt) if timestamp is not None else None


def load():
    global until
    try:
        value = json.loads(STATE.read_text())['until']
        if value is not None and (not isinstance(value, (int, float)) or isinstance(value, bool)):
            raise ValueError('invalid until')
        until = value
    except FileNotFoundError:
        pass
    except (OSError, ValueError, KeyError, TypeError):
        log('state', 'invalid')
        until = None


def save(value):
    HOME.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=HOME, delete=False) as f:
            name = f.name
            json.dump({'until': value}, f)
        os.replace(name, STATE)
    finally:
        if name and os.path.exists(name):
            os.unlink(name)


def command(args, deadline=None, retry=True):
    def run(cmd):
        timeout = min(8, max(0.01, deadline - time.monotonic())) if deadline else 8
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired):
            return None
    result = run([ADB, '-s', DEVICE] + args)
    if retry and (result is None or result.returncode "'!= 0) and (deadline is None or time.monotonic() < deadline):
        run([ADB, '"'-s', DEVICE, 'connect', DEVICE])
        if deadline is None or time.monotonic() < deadline:
            result = run([ADB, '-s', DEVICE] + args)
    return result


def read_tv(deadline=None):
    global tv, checked_at, failed_since
    result = command(['shell', 'pm', 'list', 'packages', '-d', '--user', '0'], deadline)
    with state_lock:
        if result is None or result.returncode or not result.stdout.strip():
            tv = 'unknown'
            if failed_since is None:
                failed_since = time.monotonic()
            return False
        tv = 'locked' if 'package:' + PACKAGE in result.stdout.splitlines() else 'open'
        checked_at = display(time.time(), '%H:%M:%S')
        return True


def foreground(deadline=None):
    result = command(['shell', 'dumpsys', 'activity', 'activities'], deadline)
    return bool(result and result.returncode == 0 and any('mResumedActivity' in line and PACKAGE in line for line in result.stdout.splitlines()))


def apply(forced_open=False, deadline=None):
    global last_apply, grace
    timeout = max(0, deadline - time.monotonic()) if deadline else -1
    if not adb_lock.acquire(timeout=timeout):
        return False
    try:
        if not read_tv(deadline):
            return False
        with state_lock:
            desired = 'open' if forced_open or authorized() else 'locked'
            in_grace = grace and not forced_open and desired == 'locked'
        if in_grace:
            if foreground(deadline):
                return True
            with state_lock:
                grace = False
        with state_lock:
            desired = 'open' if forced_open or authorized() else 'locked'
            current = tv
        if current "'!= desired:
            if desired == '"'locked':
                command(['shell', 'am', 'force-stop', PACKAGE], deadline)
                command(['shell', 'pm', 'disable-user', '--user', '0', PACKAGE], deadline)
            else:
                command(['shell', 'pm', 'enable', '--user', '0', PACKAGE], deadline)
            if not read_tv(deadline):
                return False
        with state_lock:
            last_apply = time.monotonic()
            return tv == desired
    finally:
        adb_lock.release()


def arrival():
    global grace
    with adb_lock:
        with state_lock:
            allowed = authorized()
        watching = not allowed and foreground()
        with state_lock:
            # A request may have changed authorization while the foreground was read.
            watching = watching and not authorized()
            if watching:
                grace = True
        if watching:
            log('arrival', 'YouTube playing; grace')
            try:
                subprocess.run([NOTIFY, '-e', 'display notification \"有人正在看 YouTube，要停請按立即鎖\" with title \"tvgate\"'], timeout=8, capture_output=True)
            except (OSError, subprocess.TimeoutExpired):
                log('notification', 'failed')
    apply()


def monitor():
    global failed_since
    previous_authorized = authorized()
    while not stop.wait(min(5, INTERVAL)):
        with state_lock:
            now_authorized = authorized()
            expired = previous_authorized and not now_authorized
            previous_authorized = now_authorized
            due = time.monotonic() - last_apply >= INTERVAL
            had_failure = failed_since
        if expired or due or had_failure is not None:
            with adb_lock:
                success = read_tv()
            if success:
                with state_lock:
                    recovery = failed_since is not None and time.monotonic() - failed_since >= 120
                    failed_since = None
                if recovery:
                    arrival()
                else:
                    apply()


def hooks():
    global hook
    while not stop.is_set():
        try:
            hook = subprocess.Popen([HOOK], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
            for line in hook.stdout:
                if stop.is_set():
                    break
                if line.strip() == 'sleep':
                    ok = apply(forced_open=True, deadline=time.monotonic() + 7.8)
                    try:
                        hook.stdin.write(('ok' if ok else 'fail') + '\\n')
                        hook.stdin.flush()
                    except (BrokenPipeError, OSError):
                        pass
                elif line.strip() == 'wake':
                    arrival()
            hook.wait()
            if not stop.is_set():
                log('hook', 'exited; restarting')
        except OSError as e:
            log('hook', str(e))
        stop.wait(1)


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(15)

    def log_message(self, fmt, *args):
        log('http', fmt % args)

    def reply(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.reply(405, {'error': 'method not allowed'})
    do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = do_GET

    def do_POST(self):
        global until, grace
        try:
            token = [REDACTED_SECRET]
        except OSError:
            token = ''
        if not token or not hmac.compare_digest(self.headers.get('X-Token', ''), token):
            return self.reply(401, {'error': 'unauthorized'})
        url = urlsplit(self.path)
        if url.path == '/status':
            with state_lock:
                return self.reply(200, {'authorized': authorized(), 'until': display(until) if authorized() else None, 'tv': tv, 'tv_checked_at': checked_at})
        if url.path not in ('/open', '/lock'):
            return self.reply(404, {'error': 'not found'})
        if url.path == '/open':
            mins = parse_qs(url.query).get('min', [])
            if len(mins) "'!= 1 or mins[0] not in ('"'15', '30', '60'):
                return self.reply(400, {'error': 'invalid min'})
            value = time.time() + int(mins[0]) * 60
        else:
            value = None
        error = None
        with state_lock:
            grace = False
            try:
                save(value)
            except OSError as e:
                error = str(e)
            if error is None or value is None:
                until = value
        if error and value is not None:
            return self.reply(500, {'ok': False, 'error': error})
        success = apply()
        if value is not None:
            with state_lock:
                success = success and authorized() and tv == 'open' and until == value
            if success:
                return self.reply(200, {'ok': True, 'until': display(value)})
            return self.reply(200, {'ok': False, 'error': '電視未確認開放', 'until': display(value), 'note': '授權仍有效，電視恢復連線後會自動開放；要取消請按立即鎖'})
        result = {'ok': success and not error}
        if error or not success:
            result['error'] = error or '電視未確認鎖定'
        self.reply(200, result)


def main():
    load()
    server = ThreadingHTTPServer(('0.0.0.0', int(os.environ.get('TVGATE_PORT', '8765'))), Handler)
    server.daemon_threads = True
    def terminate(signum, frame):
        stop.set()
        threading.Thread(target=server.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, terminate)
    threading.Thread(target=hooks, daemon=True).start()
    threading.Thread(target=monitor, daemon=True).start()
    threading.Thread(target=apply, daemon=True).start()
    server.serve_forever(poll_interval=0.1)
    deadline = time.monotonic() + 7.8
    apply(forced_open=True, deadline=deadline)
    if hook and hook.poll() is None:
        hook.terminate()
        try:
            hook.wait(timeout=max(0.1, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            hook.kill()
            hook.wait()
    server.server_close()


if __name__ == '__main__':
    main()
