+        if (changedDb) { lastSeq = maxSeq; dbId = id; }
+    }
+    enum Action { NONE, LOCK, UNLOCK, WARN, END }
+    Action decide(String yt, boolean fg, boolean screen) {
+        if (balance > 300) warned = false;
+        if (yt.equals("unknown")) return Action.NONE;
+        if (balance > 0 && yt.equals("disabled")) return Action.UNLOCK;
+        if (balance == 0 && yt.equals("enabled")) return fg && screen ? Action.END : Action.LOCK;
+        if (balance > 0 && balance <= 300 && fg && screen && !warned) { warned = true; return Action.WARN; }
+        return Action.NONE;
+    }
+    long nextAlarmMs(boolean fgAndScreen) {
+        if (!fgAndScreen) return 60000;
+        if (balance < 60) return Math.max(balance, 5) * 1000;
+        if (balance > 300) return Math.max(5, Math.min(60, balance - 300)) * 1000;
+        return 60000;
+    }
+}
