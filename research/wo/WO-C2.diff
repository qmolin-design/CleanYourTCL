+            if (fg && screen) total += e.wallMs - cursor;
+            cursor = e.wallMs;
+            switch (e.type) {
+                case 1: fg = YT.equals(e.pkg); break;
+                case 2: case 23: if (YT.equals(e.pkg)) fg = false; break;
+                case 15: screen = true; break;
+                case 16: screen = false; break;
+                case 26: fg = false; screen = false; break;
+                case 27: fg = false; screen = true; break;
+            }
+        }
