const labels={open:'開放',lock:'立即鎖',expire:'到期',schedule:'排程切斷','schedule-skipped':'排程錯過',relock:'對帳鎖回',away:'離開時開放',grace:'回家寬限','schedule-add':'新增排程','schedule-delete':'刪除排程'};
