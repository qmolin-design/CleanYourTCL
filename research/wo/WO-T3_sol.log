def wait_for(predicate, timeout=5):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if predicate(): return
        time.sleep(.05)
    raise AssertionError('等待逾時')


class GateTest(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.p = Path(self.temp.name)
        (self.p/'locked').write_text('1')
        (self.p/'front').write_text('0')
        (self.p/'token').write_text(json.dumps({'爸爸': 'test-secret', '媽媽': 'other-secret'}))
        for name, script in [('adb', ADB_SCRIPT), ('hook', HOOK_SCRIPT), ('notify', NOTIFY_SCRIPT)]:
            (self.p/name).write_text(script)
            (self.p/name).chmod(0o755)
        with socket.socket() as s:
            s.bind(('127.0.0.1', 0))
            self.port = s.getsockname()[1]
        self.env = dict(os.environ, HOME=str(self.p), TVGATE_HOME=str(self.p), TVGATE_TOKEN=str(self.p/'token'), ADB=str(self.p/'adb'), TVGATE_HOOK=str(self.p/'hook'), TVGATE_NOTIFY=str(self.p/'notify'), TVGATE_PORT=str(self.port), TVGATE_INTERVAL='0.4', TVGATE_LOG=str(self.p/'Library/Logs/tvgate.log'), TVGATE_HOME_NET=str(self.p/'home_net'), PYTHONDONTWRITEBYTECODE='1')
        (self.p/'home_net').write_text('1')
        self.proc = None
        self.start()

    def start(self):
        self.proc = subprocess.Popen([sys.executable, str(HERE/'gate.py')], env=self.env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        wait_for(lambda: self.ready())
        wait_for(lambda: (self.p/'hookstarts').exists())

    def ready(self):
        try: return self.request('/status')[0] == 200
        except (OSError, urllib.error.URLError): return False

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try: self.proc.wait(timeout=9)
            except subprocess.TimeoutExpired:
                os.killpg(self.proc.pid, signal.SIGKILL)
                self.proc.wait()
                self.fail('gate did not stop')
        if self.proc:
            try: os.killpg(self.proc.pid, 0)
            except ProcessLookupError: pass
            else:
                os.killpg(self.proc.pid, signal.SIGKILL)
                self.fail('child process left behind')

    def tearDown(self):
        try: self.stop()
        finally: self.temp.cleanup()

    def request(self, path, token='test-secret', method='POST', timeout=25, body=None):
        headers = {} if token is None else {'X-Token': token}
        req = urllib.request.Request('http://127.0.0.1:%d%s' % (self.port, path), data=(json.dumps(body).encode() if body is not None else b'') if method == 'POST' else None, headers=headers, method=method)
        try: response = urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as e: response = e
        with response: return response.status, json.load(response)

    def calls(self):
        try: return [json.loads(x) for x in (self.p/'calls').read_text().splitlines()]
        except FileNotFoundError: return []

    def event(self, event):
        (self.p/'event').write_text(event)
        wait_for(lambda: not (self.p/'event').exists())

    def state(self): return self.request('/status')[1]
    def locked(self): return (self.p/'locked').read_text() == '1'
    def lock_events(self):
        with contextlib.closing(sqlite3.connect(self.p/'tvgate.db')) as db, db:
            return db.execute("SELECT count(*) FROM events WHERE type='GATE_LOCK'").fetchone()[0]
    def two_cycles(self):
        before = len(self.calls())
        wait_for(lambda: sum('list' in a for a in self.calls()[before:]) >= 2, 8)
    def assert_lock_sequence(self, before):
        commands = [a for a in self.calls()[before:] if a in (FORCE_STOP, DISABLE)]
        self.assertTrue(any(commands[i:i+2] == [FORCE_STOP, DISABLE] for i in range(len(commands)-1)), commands)
## 運作方式
**授權有效**＝ `到期時間 > 現在`。Mac 醒著時，電視應處於「授權有效就開、否則鎖」；Mac 要睡／服務要停之前，服務盡力把 YouTube 打開。

- **服務**：`tvgate/gate.py`，只用 Python 標準函式庫，`ThreadingHTTPServer` 監聽 `0.0.0.0:8790`，每個連線 15 秒逾時。
- **端點**（全部 POST；`X-Token` header 錯或缺 → 401，狀態不變；未知路徑 404、非 POST 405、`min` 缺／非 15|30|60 → 400）：
  - `/open?min=15|30|60`：寫入到期時間＝現在＋N 分（寫檔失敗 → 回錯誤、不啟用）→ 套用 → 讀回確認已啟用才回 `{"ok":true,"until":"HH:MM"}`；電視沒開成功回 `{"ok":false,"error":"...","until":"HH:MM","note":"授權仍有效，電視恢復連線後會自動開放；要取消請按立即鎖"}`。
  - `/lock`：清到期時間（寫檔失敗仍照鎖電視，回應附錯誤）→ 套用 → 讀回確認。
  - `/status`：`{"authorized":bool,"until":"HH:MM"|null,"tv":"locked|open|unknown","tv_checked_at":"HH:MM:SS"|null}`；`tv`／`tv_checked_at` 只來自最後一次**成功**讀取，讀不到就是 `unknown`。
- **到期時間**：存 `$TVGATE_HOME/state.json`（預設 `~/Library/Application Support/tvgate/`），寫暫存檔再 `os.replace`；不存在或壞掉＝沒有授權，壞掉時 log 記一行。
- **套用（唯一會下 adb 改狀態的地方）**：拿 adb 鎖 → 讀**當下**的「該開／該鎖」（不是呼叫者當初要的）→ 讀電視實際狀態 → 不同才下指令 → 讀回。改狀態的請求只更新到期時間（瞬間完成），再呼叫套用；所以慢的 `/open` 不會蓋掉較新的 `/lock`，到期與立即鎖不必排在舊動作後面重做。
- **主迴圈**：每 5 秒醒一次；跨過到期時間、離上次對帳滿 30 秒、或上次讀取失敗後本次重連成功 → 呼叫套用。
- **讀電視狀態**：`adb -s 192.0.2.69:5555 shell pm list packages -d --user 0`；exit 0 且輸出非空（本機恆有 30+ 個停用套件）才算讀成功；**整行等於** `package:com.google.android.youtube.tv` 才算鎖定（避免誤認 `youtube.tvmusic`）。其餘＝unknown。
- **adb**：一律帶 `-s 192.0.2.69:5555`；每次 subprocess 8 秒上限；失敗先 `adb connect` 再試一次；`$ADB` 環境變數可換掉 adb 執行檔（測試用）。鎖＝`am force-stop` 再 `pm disable-user --user 0`；開＝`pm enable --user 0`；兩者都以讀回結果判定成功，不看 exit code。
- **休眠／喚醒**：`tvgate/sleephook.swift`（swiftc 編譯）由 gate.py 以子程序啟動（路徑可由 `$TVGATE_HOOK` 換掉，測試用）。收到 `NSWorkspace.willSleepNotification` → stdout 印 `sleep`，等 stdin 一行回覆（最多 10 秒）才從 handler 返回；收到 `didWakeNotification` → 印 `wake`。
  - gate.py 收到 `sleep` → 啟用 YouTube（不改到期時間），8 秒內回 `ok` 或 `fail`；收到 `wake` → 進入「回家」處理（見下）。
- **回家處理**（Owner Q5，10-30）：觸發＝sleephook 送 `wake`，或電視連續讀取失敗 ≥2 分鐘後重新讀成功。若沒有授權、且電視前景是 YouTube（`dumpsys activity activities` 的 `mResumedActivity` 含 `com.google.android.youtube.tv`）→ **不切**：log 記一行＋Mac 跳通知（`osascript -e 'display notification "有人正在看 YouTube，要停請按立即鎖" with title "tvgate"'`），進入寬限；寬限中每次對帳若前景已不是 YouTube → 鎖；家長按 `/lock` 或 `/open` → 結束寬限、照新指令。寬限只由「回家」觸發，平常對帳發現孩子自己開的照鎖。前景不是 YouTube → 照常套用。
  - 子程序結束 → log 記一行並重啟它。
  - **盡力而為**：Mac 是否真的等 handler 返回才睡，WO-T2 實測；不保證。
- **SIGTERM**（Mac 關機、登出、`launchctl bootout`／`kickstart -k`）→ 盡力啟用 YouTube（最多 8 秒）→ 結束。`kickstart -k`／當機重啟後服務會依授權重新套用（沒授權就鎖回），中間可能短暫開放，接受。
- **log**：`~/Library/Logs/tvgate.log`，一行一個事件（時間、動作、結果）。
- **token**：`~/.secrets/tvgate.token`，權限 600，不進 repo。區網 HTTP 明文傳送，同網路的人可側錄；不對外網開放。
- **iPhone 捷徑**：開放 15／30／60、立即鎖、查狀態共 5 個；網址 `http://ExampleMacBook-Pro.local:8790/...`，「取得 URL 內容」POST、header 帶 `X-Token`。顯示文字分清「已授權到 HH:MM」與「電視已開放／電視沒回應」。
- 不做：外網操作（之後要再加 Tailscale）、iPhone 推播（Owner 要再說）、網頁介面、多台電視、時鐘監控。

## 失效時的行為（照實寫）
| 情況 | 結果 |
|---|---|
# 時間管理 v4：管理網頁、使用時間統計、設備紀錄、排程切斷

狀態：APPROVED（2026-10-30 01:35，Opus）。挑戰：DEEPSEEK FLASH max（15 條）＋MUSE SPARK xhigh（15 條），裁定見文末。
建立在 PLAN_v3_service.md 之上：v3 規則（授權、對帳、休眠開放、回家寬限、失效表）不變，**只有「回家」的觸發條件改掉**（見下），其餘本檔只寫新增部分。

## Owner 裁定（10-30 01:10）
- 管理介面做網頁，Mac 與 iPhone 共用（iPhone 加到主畫面當 App）；之後「iPhone 接手管理」直接用同一頁。
- 排程只做「時間點切斷」：例如週一～五 07:40 → 清掉授權、立刻關閉並鎖住 YouTube（正在看也切）；之後家長仍可再授權。不做禁止時段。
- 設備：爸爸 iPhone、媽媽 iPhone、MacBook，各一把鑰匙；授權紀錄要記是哪個設備給的。
- 過渡期：v3 服務已暫停（01:10 bootout，YouTube 開放；plist 改名 .paused 防登入自啟），v4 驗收後再上線。

## 實機事實（01:12 查）
- 電視時區 Asia/Taipei（+0800），與 Mac 相同。
- `dumpsys usagestats` 的「Last 24 hour events」段落保留最近 24 小時事件，跨重開機保留；格式：`time="2026-10-29 22:42:40" type=ACTIVITY_RESUMED package=com.netflix.ninja class=...`。段落以標題行開始，到下一個「In-memory」標題結束。樣本：`tvgate/testdata/usagestats_events_sample.txt`（從 22:37 開機起，不是完整 24 小時；含 UNKNOWN_TYPE_ 等未知類型）。
- 8765 被 Hermes scope_proxy 占用，正式用 8790。

## v3 行為修正：「回家」觸發條件
- v3 的觸發「電視連續讀取失敗 ≥2 分鐘後重新讀成功」會被**電視拔插頭重開**觸發（TCL 開機把 YouTube 改回啟用 → 孩子開著 YouTube → 進寬限一直看），是繞過漏洞。
- 改為：只有 (a) sleephook 送 `wake`，或 (b) **Mac 自己**離開家用網路 ≥2 分鐘後回來，才算回家。判斷 Mac 在家用網路：UDP socket `connect(("192.0.2.69", 9))` 後 `getsockname()[0]` 以 `192.0.2.` 開頭（不送封包，只看路由）。電視斷線再連上＝一般對帳（沒授權就鎖，不給寬限）。

## 新增設計

### 設備鑰匙
- 鑰匙檔改為 `~/.secrets/tvgate.tokens.json`：`{"爸爸 iPhone": "<hex>", "媽媽 iPhone": "<hex>", "MacBook": "<hex>"}`，權限 600。`TVGATE_TOKEN` 指向這個檔。舊的單一 `tvgate.token` 不再讀。
- 每個請求讀一次鑰匙檔，以 `X-Token` 找出設備名稱：找不到、檔案不存在、壞掉、不是「字串→字串」的 dict → 一律 401（不是 500），文字 log 記一行（不記鑰匙內容）。改檔即生效，不必重啟（輪替：改檔刪掉那把 → `--links` → 重傳連結）。
- Mac 也用鑰匙，不開「本機免鑰匙」（避免瀏覽器跨站請求）。
- `python3 gate.py --links`：每個設備印兩行連結：`http://<LocalHostName>.local:8790/#t=<token>` 與 `http://<en0 IP>:8790/#t=<token>`（IP 版備援）。`--port` 可改；**程式預設埠改為 8790**。不啟動服務。

### 紀錄
- 文字 log 照舊（`log()` 一個函式同時寫文字 log 與 DB；DB 失敗只影響 DB，不影響文字 log 與鎖定控制）。文字 log 路徑可用 `TVGATE_LOG` 換（測試必設），預設 `~/Library/Logs/tvgate.log`。既有 log 文字不改名。
- DB：`$TVGATE_HOME/tvgate.db`。單一連線（`check_same_thread=False`）＋單一 `db_lock` 包住所有操作，`PRAGMA journal_mode=WAL`、`busy_timeout=5000`，`CREATE TABLE IF NOT EXISTS`。DB 打不開或損壞 → 服務照常啟動與鎖定，`/usage`、`/log`、`/schedule` 回 `{"error":"db"}`（HTTP 503）。
- 表 `log(ts_epoch, device, action, minutes, until, detail)`。記：`open`（設備、分鐘、到期）、`lock`（設備）、`expire`（系統）、`schedule`（排程）、`schedule-skipped`（排程，detail＝錯過的規則時間）、`relock`（系統：對帳發現沒授權卻是啟用而停回）、`away`（系統：睡前／停止時開放）、`grace`（系統：回家寬限開始）、`schedule-add`／`schedule-delete`（設備）。
- `/log` 固定回最近 30 筆，無參數。

### 使用時間（「前景時間」：App 在畫面最前面的時間，不等於真的在看）
- **抓取**：獨立背景執行緒，每 10 分鐘一次（Mac 喚醒、回家時立即一次）。用自己的鎖、自己的 adb 呼叫（15 秒上限），**不拿 adb_lock、不呼叫 read_tv、不改 failed_since 或任何鎖定狀態**。只取「Last 24 hour events」段落中 type 為 ACTIVITY_RESUMED（所有 package）、SCREEN_NON_INTERACTIVE、DEVICE_SHUTDOWN、DEVICE_STARTUP 的行，存入 `events(ts_epoch, type, package, class)`，`UNIQUE(ts_epoch, type, package, class)`。未知類型忽略不報錯。成功 → 記 `last_fetch`（存 DB）。失敗只寫文字 log。
- **gate 自己的鎖定也當事件**：每次 force-stop＋disable-user 成功，寫一筆 `events(now, 'GATE_LOCK', 'com.google.android.youtube.tv', '')`。
- **計算**：純函式 `calc(events, now, last_fetch, day_start, day_end)`，不讀系統時鐘。事件依時間排序（同秒時 RESUMED 排在結束類事件之後不影響結果）：
  - 「前景 App」＝最近一個 ACTIVITY_RESUMED 的 package。
  - 段落結束於：另一個 package 的 ACTIVITY_RESUMED、SCREEN_NON_INTERACTIVE、DEVICE_SHUTDOWN、DEVICE_STARTUP、或該 package 的 GATE_LOCK。同 package 連續 RESUMED（例如 ShellActivity→MainActivity）不切段、不重複算。
  - 最後一段沒有結束事件：算到 `min(now, last_fetch)`（`last_fetch` 是最後一次確認「之後還沒有結束事件」的時間；抓取失敗時就停在那裡，下次抓到結束事件會自動補正）；`last_fetch` 為 null → 不延伸。
  - 任一段最長 4 小時，超過截斷（防 HDMI 等沒有事件的情況無限延伸）。
  - 以秒計，切到 `[day_start, day_end)` 內；顯示時無條件捨去到分鐘。
- 統計的 App：YouTube、Netflix（com.netflix.ninja）、四季（tv.fourgtv.video）、Spotify（com.spotify.tv.android）、Disney+（com.disney.disneyplus）、HBO Max（com.wbd.stream）。其他 package 只用來結束段落，不顯示。
- 範圍：今天、本週（週一起）、本月（1 日起），本機時間。今天與本週另回每天分鐘數；本月只回總計。
- `events` 保留 40 天，每天清一次舊資料。
- 限制（頁面要寫）：Mac 離家超過 24 小時，中間電視事件會遺失而少算；HDMI 或沒有事件的情況最多多算到 4 小時；資料從服務上線才開始。

### 排程切斷
- 表 `schedule(id, days, time)`：days＝1（週一）…7（週日）的集合，time＝`HH:MM`（00:00～23:59，兩位數）。最多 20 條，超過 400。
- 判斷函式 `schedule_due(rules, prev_epoch, now_epoch) -> [(rule, target_epoch)]`：列出所有落在 `(prev, now]` 的規則時間點，**用每個時間點自己的日期判斷週幾**。
- 主迴圈：每次醒來先取 now → `due = schedule_due(rules, last_check, now)` → 先把 `last_check=now` 存進 state.json → 再處理 due：`now - target ≤ 600 秒` → 清掉授權、取消回家寬限、立刻 force-stop＋disable-user（不看前景、不給寬限）、log `schedule`；超過 600 秒（Mac 睡過頭、服務停過）→ 不切，log `schedule-skipped`。
- 服務第一次啟動（state.json 沒有 last_check）→ last_check＝now，不回補。
- 排程切斷之後，v3 的「Mac 睡前開放」照常（Owner Q1：Mac 不在就開放）；也就是排程只在 Mac 在家醒著時有效。寫進失效表。

### 網頁
- HTML、CSS、JS 全部內嵌在 gate.py，不引用外部網址；頁面本身不含任何秘密。`GET /` 回 200、`Cache-Control: no-store`；`HEAD /` 不回 body；其他路徑的 GET／HEAD 一律 405；未知路徑的 POST 404。
- 鑰匙：每次載入先讀 `location.hash` 的 `t=`（**不清掉 hash**，讓書籤與主畫面捷徑保留完整連結），讀到就同時存 localStorage；沒有 hash 才讀 localStorage；都沒有 → 顯示「請用設備連結開啟」。
- 頁面（繁體中文，手機優先、大按鈕）：
  1. 狀態：已授權到 HH:MM／未授權；電視：已開放／已鎖／無法確認；最後確認時間。每 15 秒更新。
  2. 按鈕：開放 15／30／60 分、立即鎖；按完顯示結果文字（成功／電視沒回應＋note）。
  3. 前景時間：今天／本週／本月分頁；每個 App 一條橫條＋分鐘；今天與本週列每天合計。固定顯示「資料起點」「最後抓取時間」與限制說明一行。
  4. 紀錄：最近 30 筆（時間、設備、動作、分鐘、到期），動作用中文。
  5. 排程：列出規則可刪除；新增＝勾週幾＋`<input type="time">`。
  - 頁尾：目前設備名稱。

### 端點（全部 POST＋X-Token；body 一律 JSON 或空）
- `/status`：多回 `device`。
- `/usage?range=day|week|month`：`{"range","from":"YYYY-MM-DD","apps":[{"name","minutes"}],"days":[{"date","minutes":{App:N}}]（month 為 []）,"data_since":"YYYY-MM-DD HH:MM"|null,"last_fetch":"YYYY-MM-DD HH:MM"|null}`；DB 空 → 200、全 0、null。range 錯 → 400。
- `/log`：`{"items":[...]}`。
- `/schedule`、`/schedule/add`（`{"days":[1,2,3,4,5],"time":"07:40"}`；非 JSON、days 空／重複／不在 1～7、time 格式錯、超過 20 條 → 400；相同規則已存在 → 回既有 id）、`/schedule/delete`（`{"id":N}`，不存在 → 404）。

## 失效表（新增列）
| 情況 | 結果 |
|---|---|
| 排程時間 Mac 睡著或服務沒跑 | 不切；醒來後 log `schedule-skipped`（10 分鐘內醒來仍會切） |
| 排程切斷後 Mac 闔蓋 | 照 Q1 開放 YouTube（Mac 不在＝開放） |
| 電視拔插頭重開 | 一般對帳鎖回，**不給寬限** |
| 一把鑰匙外洩 | 那把有完整管理權；改鑰匙檔刪掉即失效（不必重啟） |

## 不做
推播通知（之後 iPhone 接手管理時再做）、外網、帳號系統、修改或刪除歷史紀錄、禁止時段、事後重算、其他 App 的鎖定、唯讀鑰匙。

