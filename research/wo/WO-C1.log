  for(let i=0;i<4;i++) await sync(c,report({adb:'io'})); assert.ok((await state(c)).alerts.some(a=>a.level==='red' && a.text.includes('adb'))); assert.equal(c.sql.prepare(\"SELECT count(*) n FROM events WHERE kind='adb-bad'\").get().n,1);
